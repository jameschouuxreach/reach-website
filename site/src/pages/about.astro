---
/**
 * 關於致遠：PageHero → 我們的使命（三列圖文，版型比照政府頁；右側為原版九宮格動畫 GIF）→ ContactCta。
 * 2026-10-05 about-v2：業主指示拿掉「團隊」「合作方式」，主要內容只保留使命；
 * 滿版藍底的 MissionScrollStory（tabs 切換）改為三點分列。使命三點內容取自 src/data/mission.ts。
 * 原「致／遠的品牌哲學」區塊已於 2026-09-09 業主指示移除。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MissionPoint from '../components/about/MissionPoint.astro';
import ContactCta from '../components/ContactCta.astro';
import { MISSION_ITEMS } from '../data/mission';
---

<BaseLayout
  title="關於致遠"
  description="認識致遠體驗設計：我們的使命，以及這些理念如何落實在真實專案中。"
>
  <PageHero
    title="關於致遠"
    intro="從複雜，致清晰，陪你走得更深、更廣、更遠"
  />

  <section class="bg-surface">
    <div class="container-site py-16 md:py-24">
      {/* 區塊標籤依業主指示拿掉；保留隱藏 h2 維持標題階層（h1 → h2 → 各點 h3） */}
      <h2 class="sr-only">我們的使命</h2>
      <div class="ab-points">
        {
          MISSION_ITEMS.map((item, i) => (
            <div data-reveal>
              <MissionPoint item={item} eager={i === 0} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .ab-points {
    display: grid;
    gap: 3.5rem;
  }

  @media (min-width: 768px) {
    .ab-points {
      gap: 5rem;
    }
  }
</style>
