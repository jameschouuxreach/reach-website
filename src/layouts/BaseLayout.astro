---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAME, SITE_NAME_EN, SITE_URL, SITE_URL_CONFIRMED } from '../config';

interface Props {
  title: string;
  description: string;
  /** 首頁不加站名後綴 */
  isHome?: boolean;
  /** 分享用標題／描述（未提供時沿用 title／description） */
  ogTitle?: string;
  ogDescription?: string;
  /** 分享圖片（站內路徑，如 /images/...；未提供時用公司 Logo）。正式網域確認後才輸出 */
  ogImage?: string;
}

const { title, description, isHome = false, ogTitle, ogDescription, ogImage } = Astro.props;
const fullTitle = isHome ? title : `${title}｜${SITE_NAME} ${SITE_NAME_EN}`;
const shareTitle = ogTitle ?? fullTitle;
const shareDescription = ogDescription ?? description;
const pagePath = Astro.url.pathname;
const pageUrl = new URL(pagePath, SITE_URL).href;
const shareImage = new URL(ogImage ?? '/images/reach-logo.png', SITE_URL).href;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* TODO: 正式網域確認後（src/config.ts），canonical 自動啟用 */}
    {SITE_URL_CONFIRMED && <link rel="canonical" href={pageUrl} />}
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${SITE_NAME} ${SITE_NAME_EN}`} />
    <meta property="og:locale" content="zh_TW" />
    {SITE_URL_CONFIRMED && <meta property="og:url" content={pageUrl} />}
    {SITE_URL_CONFIRMED && <meta property="og:image" content={shareImage} />}
    <link rel="icon" type="image/png" href="/favicon/favicon-64.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-ink"
    >
      跳至主要內容
    </a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
