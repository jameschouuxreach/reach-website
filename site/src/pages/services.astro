---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCta from '../components/ContactCta.astro';
---

<BaseLayout
  title="服務內容"
  description="致遠體驗設計的服務哲學與服務分類：從研究出發，結合全局梳理與多方協作，形成可執行的改善方向。"
>
  <PageHero
    title="從未知到已知，讓改變有清楚的方向"
    intro="面對複雜問題，我們從真實情境出發，結合研究、全局梳理與多方協作，釐清真正影響成效的關鍵，形成可執行的改善方向。"
  />

  <section class="container-site py-16 md:py-24" data-reveal>
    <h2 class="heading-sub">服務哲學</h2>
    <p class="mt-4 max-w-2xl text-ink-secondary">
      我們相信好的設計始於對問題的理解。每一項服務都從研究出發，走進使用者的真實情境，再從組織與流程的全局中找出關鍵施力點。
    </p>
  </section>

  <section class="container-site pb-16 md:pb-24" data-reveal>
    <h2 class="heading-sub">服務分類</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {
        ['研究與洞察', '體驗與服務設計', '協作與落地'].map((name) => (
          <div class="card p-6">
            <h3 class="text-lg font-bold">{name}</h3>
            <p class="mt-3 text-sm text-ink-muted">正式服務名稱與內容規劃中，此分類為暫定架構。</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-ink-muted">正式服務名稱、內容與收費方式尚未定案，內容規劃中。</p>
  </section>

  <ContactCta />
</BaseLayout>
