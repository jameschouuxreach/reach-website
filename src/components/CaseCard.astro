---
/**
 * 案例卡（v1.7，參照 AJA 版式）：獨立圖片 → 客戶類別小標 → 大標題 → 專案類型 pills。
 * v1.9：支援真實案例（image／href／eyebrow／summary／cta）；未提供 image 時
 * 維持灰階佔位框，未提供 href 時為純展示卡（不可點）。
 */
interface Props {
  name: string;
  /** 客戶類別（v1.7b 版式上不顯示，保留資料欄位） */
  tag?: string;
  types?: string[];
  mediaNote?: string;
  /** 客戶名稱小標（如「好齡居 NEXDO」） */
  eyebrow?: string;
  /** 卡片摘要 */
  summary?: string;
  /** 卡片圖片（提供後取代佔位框） */
  image?: { src: string; alt: string };
  /** 內頁連結（提供後整卡可點） */
  href?: string;
  /** CTA 文字（僅在有 href 時顯示） */
  cta?: string;
}

const {
  name,
  types = ['案例整理中'],
  mediaNote = '需要素材：專案代表圖或研究現場照片',
  eyebrow,
  summary,
  image,
  href,
  cta = '查看專案',
} = Astro.props;

const Wrapper = href ? 'a' : 'article';
const wrapperProps = href
  ? { href, class: 'case-card group block no-underline', 'aria-label': `${name}：${cta}` }
  : { class: 'case-card' };
---

<Wrapper {...wrapperProps}>
  {
    image ? (
      <div class="overflow-hidden rounded-xl border border-line">
        <img
          src={image.src}
          alt={image.alt}
          width="1440"
          height="900"
          loading="lazy"
          class="case-card-img aspect-[16/10] w-full object-cover object-top"
        />
      </div>
    ) : (
      <div class="media-placeholder aspect-[16/10] rounded-xl">{mediaNote}</div>
    )
  }
  {eyebrow && <p class="mt-6 text-sm font-bold tracking-wide text-brand">{eyebrow}</p>}
  <h3 class:list={['text-xl font-bold text-ink md:text-2xl', eyebrow ? 'mt-2' : 'mt-6']}>{name}</h3>
  {summary && <p class="mt-3 leading-relaxed text-ink-secondary">{summary}</p>}
  <p class="mt-4 flex flex-wrap gap-2">
    {
      types.map((type) => (
        <span class="rounded-full border border-line bg-surface px-3.5 py-1 text-sm text-ink-secondary">
          {type}
        </span>
      ))
    }
  </p>
  {
    href && (
      <p class="mt-5">
        <span class="case-cta inline-flex items-center gap-1.5 font-semibold text-ink-secondary">
          {cta}
          <span class="cta-arrow" aria-hidden="true">→</span>
        </span>
      </p>
    )
  }
</Wrapper>

<style>
  .case-card-img {
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  a.case-card:hover .case-card-img,
  a.case-card:focus-visible .case-card-img {
    transform: scale(1.03);
  }

  a.case-card:focus-visible {
    outline: 2px solid var(--reach-blue-300);
    outline-offset: 4px;
    border-radius: 12px;
  }

  .case-cta .cta-arrow {
    transition: transform 200ms ease;
  }

  a.case-card:hover .case-cta,
  a.case-card:focus-visible .case-cta {
    color: var(--color-brand);
  }

  a.case-card:hover .cta-arrow,
  a.case-card:focus-visible .cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .case-card-img,
    .case-cta .cta-arrow {
      transition: none;
    }

    a.case-card:hover .case-card-img,
    a.case-card:focus-visible .case-card-img {
      transform: none;
    }

    a.case-card:hover .cta-arrow,
    a.case-card:focus-visible .cta-arrow {
      transform: none;
    }
  }
</style>
