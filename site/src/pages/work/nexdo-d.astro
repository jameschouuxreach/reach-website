<script>
  /**
   * 目錄增強（無 JS 時目錄仍可原生展開與跳轉）：
   * - 隨捲動標示目前段落：以段落 scroll-margin-top（＝Header＋目錄列＋餘裕）為判定線，
   *   取最近一個頂緣已越過判定線的段落；未越過第一段標案例簡介、到達閱讀區底部標內容策略。
   *   一次只標一項（aria-current="location"）；被動捲動不改 URL、不動焦點。
   * - 點卡片／目錄：目標立即標為 active 並「鎖定」，平滑捲動途中經過的段落不會閃過 active；
   *   目標抵達判定線（或頁面到底）才解除鎖定、恢復隨捲動追蹤。使用者中途以滾輪／觸控／鍵盤捲動則立即解除。
   *   以 scrollIntoView 捲動、不更新網址 hash（2026-09-14 業主指示）；窄螢幕先收合目錄再算位置，下一幀把焦點移到目標標題。
   * - 窄螢幕目錄：Escape 收合並把焦點還給 summary；收合文字更新為「本頁目錄：目前段落」。
   * - 平滑捲動由全站 CSS scroll-behavior 控制，reduced-motion 時已改為直接定位。
   */
  const root = document.querySelector<HTMLElement>('[data-nd-read]');

  if (root) {
    const parts = Array.from(root.querySelectorAll<HTMLElement>('[data-nd-part]'));
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nd-toc] a[href^="#"]'));
    const details = root.querySelector<HTMLDetailsElement>('[data-nd-toc-mobile]');
    const summary = details?.querySelector<HTMLElement>('summary') ?? null;
    const currentLabel = details?.querySelector<HTMLElement>('[data-nd-toc-current]') ?? null;
    const header = document.querySelector<HTMLElement>('body > header');
    // 收合文字用的段落名稱：直接取目錄連結文字（含編號），確保與目錄一致；沒有連結時退回 data-nd-name
    const names = new Map(parts.map((part) => [part.id, part.dataset.ndName ?? '']));
    for (const link of links) {
      const id = (link.getAttribute('href') ?? '').slice(1);
      const text = (link.textContent ?? '').trim();
      if (id && text) names.set(id, text);
    }

    let activeId = '';
    /** 點選後鎖定的目標；抵達或使用者自行捲動時解除 */
    let pendingId: string | null = null;
    let pendingUntil = 0;

    function setActive(id: string): void {
      if (id === activeId) return;
      activeId = id;
      for (const link of links) {
        if (link.getAttribute('href') === `#${id}`) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      }
      if (currentLabel) {
        currentLabel.textContent = `：${names.get(id) ?? ''}`;
        currentLabel.hidden = false;
      }
    }

    function atPageBottom(): boolean {
      return window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    }

    /** 判定線：段落 scroll-margin-top（跳轉後段落頂緣剛好落在此）＋幾 px 容差 */
    function judgeLine(): number {
      const headerBottom = header ? Math.max(0, header.getBoundingClientRect().bottom) : 0;
      const barVisible = details && summary && getComputedStyle(details).display !== 'none';
      const barHeight = barVisible ? summary.getBoundingClientRect().height : 0;
      const margin = parseFloat(getComputedStyle(parts[0]).scrollMarginTop) || 0;
      return Math.max(headerBottom + barHeight, margin) + 4;
    }

    /** 鎖定中的目標是否已抵達（頂緣落在 scroll-margin 附近，或頁面已到底無法再捲） */
    function arrived(target: HTMLElement): boolean {
      const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
      return Math.abs(target.getBoundingClientRect().top - margin) <= 3 || atPageBottom();
    }

    function update(): void {
      if (parts.length === 0) return;
      if (pendingId) {
        const target = document.getElementById(pendingId);
        if (target && !arrived(target) && performance.now() < pendingUntil) return; // 鎖定中：不隨途經段落改變
        pendingId = null;
      }
      const last = parts[parts.length - 1];
      const readEndVisible = root!.getBoundingClientRect().bottom <= window.innerHeight;
      if (atPageBottom() || readEndVisible) {
        setActive(last.id);
        return;
      }
      const line = judgeLine();
      let current = parts[0];
      for (const part of parts) {
        if (part.getBoundingClientRect().top <= line) current = part;
      }
      setActive(current.id);
    }

    let ticking = false;
    function request(): void {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    }

    /** 使用者自行捲動：解除鎖定，恢復隨捲動追蹤 */
    function release(): void {
      if (!pendingId) return;
      pendingId = null;
      request();
    }

    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    window.addEventListener('hashchange', request);
    window.addEventListener('load', request);
    window.addEventListener('wheel', release, { passive: true });
    window.addEventListener('touchmove', release, { passive: true });
    window.addEventListener('keydown', (event) => {
      if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '].includes(event.key)) release();
    });
    update();

    // 卡片與目錄的跳轉：目標立即 active 並鎖定；先收合窄螢幕目錄，原生 hash 跳轉後把焦點移到目標標題
    // 點選後只捲動、不更新網址 hash（2026-09-14 業主指示）；無 JS 時仍為原生錨點連結，直接輸入帶 hash 的網址也照常可用
    document.querySelectorAll<HTMLAnchorElement>('[data-nd-jump]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = (link.getAttribute('href') ?? '').slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        event.preventDefault();
        pendingId = id;
        pendingUntil = performance.now() + 3000; // 保險：平滑捲動異常中斷時最多鎖 3 秒
        setActive(id);
        if (details?.open && details.contains(link)) details.open = false;
        const heading = target.querySelector<HTMLElement>('[data-nd-heading]') ?? target;
        requestAnimationFrame(() => {
          target.scrollIntoView({ block: 'start' }); // 尊重 scroll-margin-top；平滑或直接定位由全站 scroll-behavior 決定
          heading.focus({ preventScroll: true });
          request();
        });
      });
    });

    details?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.open) {
        event.preventDefault();
        details.open = false;
        summary?.focus();
      }
    });
  }
</script>
