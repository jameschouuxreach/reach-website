---
/**
 * 企業頁的一列圖文：h3＋正文（左）、插圖（右）；手機單欄先文後圖。
 * markup 與 CSS 比照 public-sector/IllustratedPoint.astro（該元件綁定公共服務的圖片路徑，故另建企業版）。
 * 插圖輔助相鄰正文，alt 留空；object-fit: contain 保留全部留白，容器不加邊框、陰影或底板。
 */
import type { BusinessPoint } from '../../data/business';

interface Props extends BusinessPoint {
  /** 只有第一張圖 eager，其餘 lazy */
  eager?: boolean;
}

const { id, title, body, image, eager = false } = Astro.props;
---

<div class="biz-point" id={`biz-point-${id}`}>
  <div class="biz-point-text">
    <h3 class="biz-point-title">{title}</h3>
    <p class="biz-point-body">{body}</p>
  </div>
  <div class="biz-point-media">
    <img
      src={image.src}
      alt=""
      width={image.width}
      height={image.height}
      decoding="async"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
</div>

<style>
  .biz-point {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .biz-point {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .biz-point {
      gap: 4rem;
    }
  }

  .biz-point-text {
    max-width: 34rem;
  }

  .biz-point-title {
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem); /* 手機 22px → 桌機 28px */
    line-height: 1.45;
  }

  .biz-point-body {
    margin-top: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.8; /* 字級沿用 body：手機 16px → 桌機 18px */
  }

  .biz-point-media {
    width: 100%;
    max-width: 480px;
    margin-inline: auto;
  }

  .biz-point-media img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
</style>
