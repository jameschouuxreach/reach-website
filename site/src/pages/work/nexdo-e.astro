---
/**
 * 好齡居專案實例｜版本 E（第五版，2026-09-30）。
 * 文案依《好齡居專案實例-版本E-第五版文案與開發規格.md》第 3 節逐字上稿；版面依第 4 節：
 * B 版的寬鬆單欄、大圖與限寬文字（正文 42rem／副標 46rem／大標 52rem，圖片沿用 container-site 全寬），
 * 不設常駐目錄、閱讀進度或段尾返回連結；工作總覽五項以原生 hash 連到五段。
 *
 * 結構：開場 #intro → 挑戰 #challenges → 工作總覽 #approach → #research／#brand／#architecture／#interface／#content → 收尾。
 * 總覽主張與五段 H2 由同一份 PARTS 常數輸出，保證逐字相同。
 *
 * 圖片來源（結案簡報 PDF，頁碼從封面算第 1 頁；來源頁與裁切方式另見《好齡居專案實例-版本E-實作紀錄.md》）：
 *   E01 v4/nexdo-v4-hero.webp（沿用 D 版開場合成圖）
 *   E02 p.13、E03 p.17、E04 p.50、E05 p.28、E06 p.37、E11 p.77：依來源頁重繪為 HTML，不放整頁簡報
 *   E07 改版前：p.54 內嵌的舊首頁整頁截圖（1222×4096）；改版後：doc/素材「B.黃＆綠：Home Page.png」（1440×8128，即 p.55 內嵌截圖的原尺寸版）
 *   E08 同上改版後首頁裁四段：y 0–780／850–1727／4850–6310／6320–7488
 *   E09 p.56 內嵌的首屏截圖（1440×880）裁主張與服務入口兩處
 *   E10 p.81 內嵌照片＋原例 Do／Don’t 文字（逐字）　E12 p.80 原則文字＋內嵌原型畫面的居住安全文案區
 * 新版網站畫面為設計提案／原型；圖中灰色佔位為原型證據，不補造內容。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const IMG = '/images/work/nexdo/v5';

/** 五項工作：總覽列點、段落小字與 H2 共用（順序即閱讀順序） */
const PARTS = [
  { id: 'research', num: '01', name: '研究分析', claim: '找出誰會買單，也理解長輩的顧慮' },
  { id: 'brand', num: '02', name: '品牌定位', claim: '以居家安全為起點，說清楚好齡居的專業' },
  { id: 'architecture', num: '03', name: '資訊架構設計', claim: '讓使用者從自己的需求，找到適合的服務' },
  { id: 'interface', num: '04', name: '介面與原型設計', claim: '先讓人看懂服務，再引導下一步' },
  { id: 'content', num: '05', name: '內容策略', claim: '把品牌特質，變成寫得出來的文案' },
] as const;

const [RESEARCH, BRAND, ARCHITECTURE, INTERFACE, CONTENT] = PARTS;

/** 挑戰標題依 2026-09-30 指示逐字（含「看的」，不自行校字） */
const CHALLENGES = [
  {
    title: '需要服務的是長輩，想購買的是子女，要如何讓雙方都買單？',
    body: '子女希望替長輩改善生活，長輩卻未必有相同想法。品牌需要釐清誰會購買，也理解服務如何被使用者接受。',
  },
  {
    title: '服務分很多種類，客戶看的頭昏眼花',
    body: '當分類相近、名稱抽象，使用者就得先研究整份清單，才能判斷哪些服務與自己有關。',
  },
  {
    title: '說不清品牌價值，被當成單純清潔服務',
    body: '好齡居涵蓋安全、健康與居家生活等協助，需要一個明確的主打方向，讓人理解這些服務為何值得選擇。',
  },
];

/** E02：問卷收斂的受眾輪廓（p.13；不帶 AI 人像、角色姓名與引言） */
const AUDIENCE_PROFILE = ['25～54 歲', '與長輩同住', '為長輩購買', '關注安全', '有預算考量'];

/** E03：研究歸納的雙方需求（p.17；不用引號） */
const FAMILY_NEEDS = [
  { role: '子女', items: ['希望付出與照顧被看見', '希望長輩平安健康'] },
  { role: '長輩', items: ['希望被當作有自主權的人', '不想成為家人的負擔'] },
];

/** E04：以居家安全為起點的服務定位（p.50） */
const SERVICE_FOCUS = { start: '居家安全', extends: ['收納清潔', '租房搬家', '樂齡健康', '軟裝設計'] };

/** E05：五大品牌特質與兩個實踐面向（p.28） */
const BRAND_TRAITS = [
  { layer: '執行層面', traits: [['專業', '專業有保障'], ['完善', '全面完善']] },
  { layer: '溝通層面', traits: [['溫暖', '溫暖舒適'], ['彈性', '彈性不強迫'], ['共創', '平等共創']] },
];

/** E06：服務分類前後完整細項（p.37；沿 D 版常數原樣複製，不 import D 頁）。「居家整聊」為來源名稱，不改字 */
const MERGED = ['居家整聊', '室內清運', '收納規劃'];
const CATEGORIES_BEFORE = [
  { name: '居家照護', items: ['居家整聊', '安全評估', '衛浴裝修', '安心移居'] },
  { name: '適老換屋', items: ['適老換屋', '舊屋診斷', '代租代管', '房屋仲介'] },
  { name: '居家改造', items: ['軟裝設計', '室內清運', '收納規劃'] },
  { name: '關懷陪伴', items: ['牙科衛教', '營養諮詢', '體適能'] },
];
const CATEGORIES_AFTER = [
  { name: '居家安全', items: ['舊屋診斷', '安全評估', '衛浴裝修'] },
  { name: '收納清潔', items: ['室內清運', '收納規劃', '居家整聊'], note: '整併' },
  { name: '租房搬家', items: ['適老換屋', '安心移居', '代租代管', '房屋仲介'] },
  { name: '樂齡健康', items: ['牙科衛教', '營養諮詢', '體適能'] },
  { name: '獨立服務', items: ['軟裝設計'], note: '獨立' },
];

/** E07：首頁前後對照（標籤與說明依第 3.7 節） */
const HOME_COMPARE = [
  {
    key: 'before',
    tag: '改版前',
    label: '先列出服務與細節',
    desc: '使用者需要自行拼湊服務範圍，再判斷哪些項目與自己有關。',
    src: `${IMG}/e07-home-before.webp`,
    alt: '好齡居改版前首頁',
    width: 480,
    height: 1609,
  },
  {
    key: 'after',
    tag: '改版後',
    label: '先理解，再往下選擇',
    desc: '依序介紹品牌、服務與信任依據，最後提供開始諮詢的方向。',
    src: `${IMG}/e07-home-after.webp`,
    alt: '好齡居改版後首頁設計示意',
    width: 480,
    height: 2709,
  },
];

/** E08：首頁四階段（同一新版首頁的四個區域） */
const HOME_STAGES = [
  {
    name: '建立印象',
    desc: '先說明好齡居關注的生活問題，讓讀者知道這個品牌與自己有什麼關係。',
    src: `${IMG}/e08-1-impression.webp`,
    height: 650,
  },
  {
    name: '了解服務',
    desc: '以清楚的分類介紹能提供的協助，幫助讀者掌握服務範圍。',
    src: `${IMG}/e08-2-services.webp`,
    height: 731,
  },
  {
    name: '取得信任',
    desc: '進一步呈現專業與服務資訊，回應讀者評估時的疑問。',
    src: `${IMG}/e08-3-trust.webp`,
    height: 1217,
  },
  {
    name: '引導行動',
    desc: '交代諮詢方式與下一步，讓有需求的人知道如何開始。',
    src: `${IMG}/e08-4-action.webp`,
    height: 973,
  },
];

/** E09：兩項設計策略的首屏局部（p.56） */
const STRATEGIES = [
  {
    name: '吸引注意',
    desc: '以生活相關的主張，建立閱讀的起點。',
    src: `${IMG}/e09-1-attention.webp`,
    alt: '首頁以生活主張吸引注意的設計實例：陪伴您把居家環境變安全，擁有安心自在的樂齡日常',
    width: 660,
    height: 220,
  },
  {
    name: '輕鬆理解',
    desc: '透過服務入口與資訊分層，提供往下閱讀的方向。',
    src: `${IMG}/e09-2-clarity.webp`,
    alt: '首頁以服務入口協助理解的設計實例：居住安全、清潔收納、樂齡健康、買賣房屋＆租房、軟裝設計',
    width: 530,
    height: 280,
  },
];

/** E11：品牌特質 → 七項指南（p.77，依原頁欄位順序） */
const PRINCIPLE_MAP = [
  { trait: '專業有保障', voice: '講效益', guides: ['談效益而非服務規格', '專業建議'] },
  { trait: '溫暖舒適', voice: '講暖話', guides: ['日常關心'] },
  { trait: '平等共創', voice: '講我們', guides: ['去失能化', '夥伴關係'] },
  { trait: '全面完善', voice: '講貼心', guides: ['服務完善可自由選擇'] },
  { trait: '彈性不強迫', voice: '講隨緣', guides: ['小投入大改善'] },
];

const DESCRIPTION = '致遠從受眾研究出發，協助好齡居確立品牌主張、重整服務分類與首頁，並建立可沿用的文案指南。';
---

<BaseLayout
  title="好齡居品牌與網站改版｜第五版｜致遠專案實例"
  description={DESCRIPTION}
  isHome
  ogTitle="從看不懂服務，到知道如何開始：好齡居品牌與網站改版"
  ogDescription={DESCRIPTION}
  ogImage="/images/work/nexdo/v4/nexdo-v4-og.jpg"
>
  <article class="ne">
    {/* ---- 開場 ---- */}
    <section id="intro" class="ne-section ne-intro">
      <div class="container-site">
        <p class="ne-eyebrow">好齡居 NEXDO｜銀髮生活服務</p>
        <h1 class="ne-h1">從看不懂服務，到知道如何開始：好齡居品牌與網站改版</h1>
        <p class="ne-lead">
          好齡居整合居家安全、整理清潔與健康支持等銀髮生活服務，希望協助長輩安心生活。然而，服務項目多，家庭做決定時的考量也多，光把服務列出來，還不足以讓人理解與選擇。致遠從受眾研究出發，協助好齡居找出品牌主打方向，重整服務分類、首頁與文案，讓專業更容易被理解。
        </p>

        <dl class="ne-meta">
          <div class="ne-meta-item">
            <dt>客戶</dt>
            <dd>好齡居 NEXDO</dd>
          </div>
          <div class="ne-meta-item">
            <dt>合作範圍</dt>
            <dd>受眾研究、品牌定位、資訊架構、介面與原型設計、內容策略</dd>
          </div>
        </dl>

        {/* E01：沿用 D 版開場合成圖，保留原比例與 Logo */}
        <figure class="ne-fig ne-fig-hero">
          <div class="ne-frame">
            <img
              src="/images/work/nexdo/v4/nexdo-v4-hero.webp"
              alt="好齡居 Logo 與筆電中的首頁改版設計"
              width="1920"
              height="1080"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <figcaption class="ne-caption">從品牌主張、服務入口到諮詢引導，我們將研究發現轉成具體的網站設計。</figcaption>
        </figure>
      </div>
    </section>

    {/* ---- 挑戰：所有寬度皆直向三項 ---- */}
    <section id="challenges" class="ne-section">
      <div class="container-site">
        <h2 class="ne-h2" tabindex="-1">本案遇到哪些挑戰？</h2>
        <ol class="ne-challenges">
          {
            CHALLENGES.map((item, i) => (
              <li class="ne-challenge">
                <span class="ne-challenge-num" aria-hidden="true">{`0${i + 1}`}</span>
                <div>
                  <h3 class="ne-challenge-title">{item.title}</h3>
                  <p class="ne-p">{item.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ---- 工作總覽：五項直向列點，整列為原生連結（不是常駐目錄） ---- */}
    <section id="approach" class="ne-section">
      <div class="container-site">
        <h2 class="ne-h2" tabindex="-1">我們做了什麼？</h2>
        <p class="ne-sub">從理解家庭的需求開始，逐步確立品牌主張、整理服務入口，再落實到網站與文案。</p>
        <ol class="ne-overview">
          {
            PARTS.map((part) => (
              <li>
                <a href={`#${part.id}`} class="ne-overview-link" data-ne-jump>
                  <span class="ne-overview-name">{`${part.num} ${part.name}`}</span>
                  <span class="ne-overview-claim">{part.claim}</span>
                  <span class="ne-overview-cta">
                    查看更多<span aria-hidden="true" class="ne-overview-arrow">↓</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ---- 01 研究分析 ---- */}
    <section id={RESEARCH.id} class="ne-section">
      <div class="container-site">
        <p class="ne-kicker">{`${RESEARCH.num} ${RESEARCH.name}`}</p>
        <h2 class="ne-h2" tabindex="-1">{RESEARCH.claim}</h2>
        <p class="ne-sub ne-sub-pair"><span>問卷找出購買族群。</span><span>訪談理解雙方顧慮。</span></p>

        <h3 class="ne-h3">從問卷找出主要溝通對象</h3>
        <p class="ne-p">
          我們分析 303 份問卷，比較居住狀況、購買對象與服務需求，將主要溝通對象聚焦在與長輩同住、希望替長輩購買服務的成年子女。這群人重視安全，也有預算考量，因此後續設計優先回應居家風險與可負擔的改善需求。
        </p>
        {/* E02：p.13 重繪 */}
        <figure class="ne-fig">
          <div class="ne-panel">
            <p class="ne-panel-label">問卷收斂的受眾輪廓</p>
            <ul class="ne-profile">
              {AUDIENCE_PROFILE.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <figcaption class="ne-caption">受眾輪廓讓品牌有了優先溝通的對象，也確立安全與預算是服務說明的重要內容。</figcaption>
        </figure>

        <h3 class="ne-h3">透過訪談，看見家庭做決定時的兩種考量</h3>
        <p class="ne-p">
          5 位深度訪談讓我們看見：子女擔心安全、希望照顧的心意被理解，長輩則在意自己是否還能決定生活。服務能否被接受，還取決於如何討論改變，因此我們把尊重選擇與平等溝通納入品牌及文案方向。
        </p>
        {/* E03：p.17 重繪；研究歸納，不加引號 */}
        <figure class="ne-fig">
          <div class="ne-panel">
            <p class="ne-panel-label">研究歸納</p>
            <div class="ne-pair">
              {
                FAMILY_NEEDS.map((side) => (
                  <div class="ne-pair-col">
                    <p class="ne-pair-role">{side.role}</p>
                    <ul class="ne-bullets">
                      {side.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                ))
              }
            </div>
          </div>
          <figcaption class="ne-caption">同一項居家改善，需要回應子女的安心與長輩的自主；這也成為後續品牌語氣與服務溝通的依據。</figcaption>
        </figure>
      </div>
    </section>

    {/* ---- 02 品牌定位 ---- */}
    <section id={BRAND.id} class="ne-section">
      <div class="container-site">
        <p class="ne-kicker">{`${BRAND.num} ${BRAND.name}`}</p>
        <h2 class="ne-h2" tabindex="-1">{BRAND.claim}</h2>
        <p class="ne-sub ne-sub-pair"><span>從家庭需求出發。</span><span>確立品牌主張與溝通方式。</span></p>

        <h3 class="ne-h3">為多元服務，找到一個清楚的主打方向</h3>
        <p class="ne-p">
          居家安全是受眾重視的需求，因此我們建議好齡居以此作為品牌溝通的起點。從安全生活出發，再介紹整理、清潔與其他協助，讓人理解好齡居提供的專業如何超越一般居家清潔。
        </p>
        {/* E04：p.50 重繪為起點＋延伸的關係圖（不畫成果成長箭頭） */}
        <figure class="ne-fig">
          <div class="ne-panel">
            <div class="ne-hub">
              <div class="ne-hub-start">
                <p class="ne-panel-label">起點</p>
                <p class="ne-hub-node ne-hub-node-main">{SERVICE_FOCUS.start}</p>
              </div>
              <div class="ne-hub-branch">
                <p class="ne-panel-label">延伸協助</p>
                <ul class="ne-hub-list">
                  {SERVICE_FOCUS.extends.map((item) => <li class="ne-hub-node">{item}</li>)}
                </ul>
              </div>
            </div>
          </div>
          <figcaption class="ne-caption">各項服務有了共同的介紹方向，品牌便能先說清楚核心價值，再帶出延伸協助。</figcaption>
        </figure>

        <h3 class="ne-h3">用五大特質，定義專業如何被感受到</h3>
        <p class="ne-p">
          我們將品牌特質整理為「專業、完善、溫暖、彈性、共創」。專業與完善回應服務品質的期待；溫暖、彈性與共創則提醒品牌，在提供建議時，也要聆聽家庭成員的想法、保留選擇。
        </p>
        {/* E05：p.28 重繪；不放報告標題 */}
        <figure class="ne-fig">
          <div class="ne-traits">
            {
              BRAND_TRAITS.map((group) => (
                <div class="ne-panel ne-traits-group">
                  <p class="ne-panel-label">{group.layer}</p>
                  <ul class="ne-traits-list">
                    {group.traits.map(([trait, note]) => (
                      <li class="ne-trait">
                        <span class="ne-trait-name">{trait}</span>
                        <span class="ne-trait-note">{note}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <figcaption class="ne-caption">品牌定位不只決定要說什麼，也定義服務與溝通應該如何實踐。</figcaption>
        </figure>
      </div>
    </section>

    {/* ---- 03 資訊架構設計 ---- */}
    <section id={ARCHITECTURE.id} class="ne-section">
      <div class="container-site">
        <p class="ne-kicker">{`${ARCHITECTURE.num} ${ARCHITECTURE.name}`}</p>
        <h2 class="ne-h2" tabindex="-1">{ARCHITECTURE.claim}</h2>
        <p class="ne-sub">品牌有了主打方向，網站也需要用受眾理解的方式，整理每一項協助。</p>

        <h3 class="ne-h3">把相近的服務，放進同一個入口</h3>
        <p class="ne-p">
          原本分散的居家整聊、室內清運與收納規劃，被整合到「收納清潔」之下。購買動機不同的軟裝設計則獨立呈現，讓想整理空間與想重新布置的人，各有清楚的尋找方向。
        </p>

        <h3 class="ne-h3">讓類別名稱直接說明用途</h3>
        <p class="ne-p">
          我們將服務重整為「居家安全、收納清潔、租房搬家、樂齡健康」四個主要入口，另保留軟裝設計。相較於「適老換屋」「關懷陪伴」等較抽象的名稱，新分類更直接提示服務內容，減少第一次接觸時的猜測。
        </p>
        {/* E06：p.37 重繪，保留完整細項；整併的三項以藍色標示 */}
        <figure class="ne-fig">
          <div class="ne-cats">
            <div class="ne-panel ne-cats-side">
              <p class="ne-panel-label">改版前</p>
              <ul class="ne-cats-list">
                {
                  CATEGORIES_BEFORE.map((cat) => (
                    <li class="ne-cat">
                      <span class="ne-cat-name">{cat.name}</span>
                      <ul class="ne-cat-items">
                        {cat.items.map((item) => (
                          <li class:list={['ne-chip', { 'ne-chip-merged': MERGED.includes(item), 'ne-chip-solo': item === '軟裝設計' }]}>
                            {item}
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="ne-panel ne-cats-side">
              <p class="ne-panel-label ne-panel-label-brand">改版後</p>
              <ul class="ne-cats-list">
                {
                  CATEGORIES_AFTER.map((cat) => (
                    <li class="ne-cat">
                      <span class="ne-cat-name ne-cat-name-after">
