---
/**
 * 致遠觀點列表：PageHero → 一張真實文章卡 → 既有 ContactCta。
 * 移除原本的預留分類 pills 與三張「文章整理中」假卡；封面沿用文章圖 1（真實配圖），
 * 標題／摘要取自 src/data/insights.ts，與文章頁、sitemap 共用同一份 metadata。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCta from '../components/ContactCta.astro';
import { FIRST_INSIGHT_ARTICLE } from '../data/insights';
---

<BaseLayout
  title="致遠觀點"
  description="致遠體驗設計對使用者研究、服務設計與數位轉型的觀察與思考。"
>
  <PageHero
    title="致遠觀點"
    intro="從真實的使用困擾出發，分享研究與設計如何幫助團隊找到改善方向。"
  />

  <section class="container-site py-16 md:py-24" data-reveal>
    <a href={FIRST_INSIGHT_ARTICLE.path} class="insight-card group block max-w-[680px] no-underline">
      <div class="insight-card-cover overflow-hidden rounded-xl border border-line">
        <img
          src="/images/insights/figure-supermarket.webp"
          alt=""
          width="1600"
          height="800"
          loading="lazy"
          decoding="async"
          class="insight-card-cover-img"
        />
      </div>
      <p class="mt-6 text-sm font-bold tracking-wide text-brand">{FIRST_INSIGHT_ARTICLE.category}</p>
      <h2 class="insight-card-title mt-2 text-xl font-bold text-ink md:text-2xl">{FIRST_INSIGHT_ARTICLE.title}</h2>
      <p class="mt-3 leading-relaxed text-ink-secondary">{FIRST_INSIGHT_ARTICLE.description}</p>
      <p class="insight-card-cta mt-5 inline-flex items-center gap-1.5 font-semibold text-brand">
        閱讀文章
        <span class="cta-arrow" aria-hidden="true">→</span>
      </p>
    </a>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  /* 封面：文章圖 1（真實配圖），hover 時比照 CaseCard 的輕微放大 */
  .insight-card-cover {
    background-color: var(--color-surface-accent);
  }

  .insight-card-cover-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1600 / 800;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .insight-card:hover .insight-card-cover-img,
  .insight-card:focus-visible .insight-card-cover-img {
    transform: scale(1.03);
  }

  .insight-card-title,
  .insight-card-cta {
    transition: color 200ms ease;
  }

  .insight-card:hover .insight-card-title,
  .insight-card:focus-visible .insight-card-title,
  .insight-card:hover .insight-card-cta,
  .insight-card:focus-visible .insight-card-cta {
    color: var(--color-brand);
  }

  .insight-card:focus-visible {
    outline: 2px solid var(--reach-blue-300);
    outline-offset: 4px;
    border-radius: 12px;
  }

  .insight-card-cta .cta-arrow {
    transition: transform 200ms ease;
  }

  .insight-card:hover .cta-arrow,
  .insight-card:focus-visible .cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .insight-card-title,
    .insight-card-cta,
    .insight-card-cta .cta-arrow,
    .insight-card-cover-img {
      transition: none;
    }
    .insight-card:hover .cta-arrow,
    .insight-card:focus-visible .cta-arrow,
    .insight-card:hover .insight-card-cover-img,
    .insight-card:focus-visible .insight-card-cover-img {
      transform: none;
    }
  }
</style>
