<style>
  /*
   * 尺寸變數：Header 高度（SiteHeader：手機 h-16＋1px 底線＝65px／md+ 72px＋1px＝73px）、
   * 窄螢幕目錄列高度、展開清單上限。
   * 錨點 scroll-margin：桌面 Header＋24px；窄螢幕再加目錄列；無 JS 下展開目錄時（:has）再加清單高度。
   */
  .nd {
    --nd-header: 65px;
    --nd-tocbar: 3rem;
    --nd-toclist: 15rem;
  }

  @media (min-width: 768px) {
    .nd {
      --nd-header: 73px;
    }
  }

  .nd [id] {
    scroll-margin-top: calc(var(--nd-header) + 1.5rem);
  }

  @media (max-width: 1023.98px) {
    .nd .nd-part {
      scroll-margin-top: calc(var(--nd-header) + var(--nd-tocbar) + 1rem);
    }

    .nd-read:has(.nd-toc-m[open]) .nd-part {
      scroll-margin-top: calc(var(--nd-header) + var(--nd-tocbar) + var(--nd-toclist) + 1rem);
    }
  }

  /* 區塊進場：位移 ≤20px、450ms（覆蓋全站 650ms） */
  :global(html.js) [data-reveal] {
    transition-duration: 450ms;
  }

  /* ---- 文字層級 ---- */
  .nd-eyebrow {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-brand);
  }

  .nd-h1 {
    margin-top: 0.875rem;
    max-width: 52rem;
    font-size: clamp(1.875rem, 1.3rem + 2.2vw, 3.25rem);
    line-height: 1.25;
