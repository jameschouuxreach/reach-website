---
/**
 * 關於頁「我們的使命」的一列：編號＋標題＋內文＋真實案例卡（左）、原版九宮格動畫 GIF（右）；手機單欄先文後圖。
 * 版型比照政府頁 IllustratedPoint。GIF 由 MissionScrollStory 原版幾何與時序逐幀輸出（每列一段：外圍圓→連線→填滿），
 * reduced-motion 改用同名 PNG 終態。圖示輔助相鄰正文，alt 留空。
 */
import type { MissionItem } from '../../data/mission';

interface Props {
  item: MissionItem;
  /** 品牌對應詞：更深／更廣／更遠 */
  word: string;
  /** 只有第一列 eager，其餘 lazy */
  eager?: boolean;
}

const { item, word, eager = false } = Astro.props;
const [exName = '', ...rest] = item.example.project.split('｜');
const exSub = rest.join('｜');
const src = `/images/about/mission-${item.index}`;
---

<article class="mp">
  <div class="mp-text">
    <p class="mp-index">{item.index} {word}</p>
    <h3 class="mp-title">{item.title}</h3>
    <p class="mp-body">{item.body}</p>
    <div class="mp-example">
      <p class="mp-ex-label">真實案例｜{exName}</p>
      <p class="mp-ex-title">{exSub}</p>
      <p class="mp-ex-body">{item.example.body}</p>
    </div>
  </div>
  <div class="mp-media">
    <picture>
      <source srcset={`${src}.png`} media="(prefers-reduced-motion: reduce)" />
      <img
        src={`${src}.gif`}
        alt=""
        width="720"
        height="720"
        decoding="async"
        loading={eager ? 'eager' : 'lazy'}
      />
    </picture>
  </div>
</article>

<style>
  .mp {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .mp {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .mp {
      gap: 4rem;
    }
  }

  .mp-text {
    max-width: 34rem;
  }

  .mp-index {
    color: var(--color-brand);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .mp-title {
    margin-top: 0.5rem;
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem); /* 手機 22px → 桌機 28px，同政府頁 */
    font-weight: 700;
    line-height: 1.45;
  }

  .mp-body {
    margin-top: 0.875rem;
    color: var(--color-ink-secondary);
    line-height: 1.8;
  }

  .mp-example {
    margin-top: 1.5rem;
    padding: 1.25rem 1.375rem;
    background-color: var(--color-page);
    border-radius: 14px;
  }

  .mp-ex-label {
    color: var(--color-brand);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .mp-ex-title {
    margin-top: 0.375rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .mp-ex-body {
    margin-top: 0.5rem;
    color: var(--color-ink-secondary);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .mp-media {
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
  }

  .mp-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }
</style>
