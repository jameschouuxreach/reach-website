---
/**
 * 案例卡：名稱＋類型標籤＋問題一句＋灰階圖片佔位框。
 * 個案頁未建立前 CTA 一律顯示「內容準備中」並停用（不連往 # 或空白頁）。
 */
interface Props {
  name: string;
  tag: string;
  description?: string;
  mediaNote?: string;
}

const {
  name,
  tag,
  description = '案例內容整理中',
  mediaNote = '需要素材：專案代表圖或研究現場照片',
} = Astro.props;
---

<article class="card flex h-full flex-col overflow-hidden">
  <div class="media-placeholder aspect-[16/10] rounded-none border-x-0 border-t-0">
    {mediaNote}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p>
      <span class="inline-block rounded-full bg-accent px-3 py-1 text-xs font-semibold text-link">{tag}</span>
    </p>
    <h3 class="mt-3 text-lg font-bold">{name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-secondary">{description}</p>
    <p class="mt-auto pt-4">
      <span
        class="inline-flex min-h-11 cursor-not-allowed items-center gap-1.5 text-sm font-semibold text-ink-soft"
        aria-disabled="true"
      >
        內容準備中
      </span>
    </p>
  </div>
</article>
