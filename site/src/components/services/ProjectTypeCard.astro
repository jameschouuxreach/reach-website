---
/**
 * 專案類型摘要卡（探索型／優化型各三張）：整張卡為單一 <a>，卡內不另放文字 CTA
 *（2026-09-08 業主指示移除原本卡底的「查看說明 →」，讓卡片高度隨內容縮短；可點擊由 hover／focus 的
 * Blue 50 底、品牌藍框與標題轉藍表達）。
 * 內容順序：專案類型標題 → 副標 → 小標「適合以下情況」→ fit 三點列表。
 * headingLevel 由父層依標題階層傳入（ProjectTypeGroups：h1 模式用 h3、h2 模式用 h4；ServiceItemProjectTabs 用 h3），避免跳級。
 * 右下角以該專案類型標誌作裝飾（2026-08-31 業主指示）：標誌不完整呈現，被卡片右下邊裁切、只露出左上部分；
 * 純裝飾且置於內容之下（isolate＋z-index:-1），不影響文字可讀性與點擊。
 */
import type { ProjectType } from '../../data/services';
import { getProjectTypePath } from '../../data/services';
import ProjectGlyph from './ProjectGlyph.astro';

interface Props extends ProjectType {
  headingLevel?: 'h3' | 'h4';
}

const { slug, title, subtitle, fit, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const href = getProjectTypePath(slug);
---

<a href={href} class="svc-link-card card relative isolate flex h-full flex-col overflow-hidden p-6 no-underline md:p-7">
  <ProjectGlyph slug={slug} class="svc-card-glyph" />
  <Heading class="svc-card-title text-[1.375rem] font-bold text-ink md:text-2xl">{title}</Heading>
  <p class="mt-3 text-[17px] font-semibold leading-relaxed text-ink md:text-lg">{subtitle}</p>
  <p class="mt-5 text-sm font-bold text-brand">適合以下情況</p>
  {/* 三點列表每點 ≤15 字；15px 字級＋14px 縮排＋桌機內距 28px，確保 1024px 三欄時仍單行 */}
  <ul class="mt-2 list-disc space-y-1 pl-3.5 text-[15px] leading-relaxed text-ink-secondary marker:text-brand">
    {fit.map((line) => <li>{line}</li>)}
  </ul>
</a>

<style>
  /* 右下角裝飾標誌：約六成卡寬，往右下各推出兩成多，只露出標誌左上部分；透明度 30%（2026-08-31 業主指示） */
  .svc-card-glyph {
    position: absolute;
    z-index: -1;
    right: -22%;
    bottom: -26%;
    width: 64%;
    height: auto;
    opacity: 0.3;
    pointer-events: none;
  }

  .svc-link-card {
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      transform 120ms ease;
  }

  .svc-link-card:hover,
  .svc-link-card:focus-visible {
    background-color: var(--reach-blue-50);
    border-color: var(--color-brand);
  }

  .svc-link-card:active {
    transform: translateY(1px);
  }

  .svc-link-card:focus-visible {
    outline: 2px solid var(--reach-blue-300);
    outline-offset: 3px;
  }

  .svc-card-title {
    transition: color 200ms ease;
  }

  .svc-link-card:hover .svc-card-title,
  .svc-link-card:focus-visible .svc-card-title {
    color: var(--color-brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-link-card,
    .svc-card-title {
      transition: none;
    }

    .svc-link-card:active {
      transform: none;
    }
  }
</style>
