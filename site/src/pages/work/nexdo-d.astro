<style>
  /*
   * 尺寸變數：Header 高度（SiteHeader：手機 h-16＋1px 底線＝65px／md+ 72px＋1px＝73px）、
   * 窄螢幕目錄列高度、展開清單上限。
   * 錨點 scroll-margin：桌面 Header＋24px；窄螢幕再加目錄列；無 JS 下展開目錄時（:has）再加清單高度。
   */
  .nd {
    --nd-header: 65px;
    --nd-tocbar: 3rem;
    --nd-toclist: 23rem; /* 八項 × 44px＋內距，不需清單內捲動 */
  }

  @media (min-width: 768px) {
    .nd {
      --nd-header: 73px;
    }
  }

  .nd [id] {
    scroll-margin-top: calc(var(--nd-header) + 1.5rem);
  }

  @media (max-width: 1023.98px) {
    .nd .nd-part {
      scroll-margin-top: calc(var(--nd-header) + var(--nd-tocbar) + 1rem);
    }

    .nd-read:has(.nd-toc-m[open]) .nd-part {
      scroll-margin-top: calc(var(--nd-header) + var(--nd-tocbar) + var(--nd-toclist) + 1rem);
    }
  }

  /* 本頁不使用區塊淡入動畫（2026-09-14 業主指示）：全頁無 data-reveal，內容直接顯示 */

  /* ---- 文字層級 ---- */
  .nd-eyebrow {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-brand);
  }

  /* 開場：大標、導言、資訊列、F01 共用版心同一欄寬，右緣對齊（2026-09-11 業主指示，參考悠識案例頁）；
     大標上限 42px，1440 寬時單行 */
  .nd-h1 {
    margin-top: 0.875rem;
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.625rem);
    line-height: 1.3;
    font-weight: 700;
    color: var(--neutral-900);
  }

  .nd-lead {
    margin-top: 1.5rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.9;
    color: var(--neutral-600);
  }

  .nd-meta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    border-top: 1px solid var(--neutral-200);
    border-bottom: 1px solid var(--neutral-200);
    padding-block: 1.125rem;
  }

  .nd-meta-item dt {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--neutral-500);
  }

  .nd-meta-item dd {
    margin-top: 0.125rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--neutral-900);
  }

  /* 標題、副標、內文、圖說一律與圖片同寬（正文欄寬），不另設 max-width（2026-09-14 業主指示） */
  .nd-h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2.125rem);
    line-height: 1.35;
    font-weight: 700;
    color: var(--neutral-900);
  }

  .nd-h1:focus-visible,
  .nd-h2:focus-visible {
    outline-offset: 6px;
