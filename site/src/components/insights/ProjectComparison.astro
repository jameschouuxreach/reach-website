---
/**
 * 架構重整型／流程優化型專案比較（2026-09-22 改版）。
 * - 欄序固定：架構重整型在左、流程優化型在右（與鎖定文案表格一致）。
 * - 列序固定：適用情境／專案重點／執行方式／了解專案。
 * - ≥1024px 用真實 <table>（caption 視覺隱藏、th scope 完整）；<1024px 改兩張垂直卡片，
 *   同一份 PROJECT_COMPARISON_ROWS 供兩種版式共用，CSS 以 display:none 保證同一時刻只有一版進入
 *   存取樹與鍵盤順序（見 insight-article.css 的 .ic-table-wrap／.ic-cards）。
 * - 「了解專案」為文字連結（沿用全站 .text-cta），非大型主視覺按鈕。
 * - 「執行方式」欄內文分兩行（如「資訊架構重整為主」／「易用性測試為輔」），以 <br> 呈現。
 */
import { PROJECT_COMPARISON_ROWS, PROJECT_TYPE_LABELS } from '../../data/insights';

const fields = [
  { key: 'situation', label: '適用情境' },
  { key: 'focus', label: '專案重點' },
  { key: 'approach', label: '執行方式' },
] as const;
---

<div class="ic-table-wrap">
  <table class="ic-table">
    <caption class="sr-only">架構重整型與流程優化型專案比較</caption>
    <thead>
      <tr>
        <th scope="col">
          <span class="sr-only">項目</span>
        </th>
        {PROJECT_TYPE_LABELS.map((type) => <th scope="col">{type.title}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        fields.map((field) => (
          <tr>
            <th scope="row">{field.label}</th>
            {PROJECT_COMPARISON_ROWS.map((row) => (
              <td>
                {row[field.key].map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))}
              </td>
            ))}
          </tr>
        ))
      }
      <tr>
        <th scope="row">了解專案</th>
        {
          PROJECT_COMPARISON_ROWS.map((row) => (
            <td>
              <a href={row.ctaHref} class="text-cta">
                {row.ctaLabel}
                <span class="cta-arrow" aria-hidden="true">→</span>
              </a>
            </td>
          ))
        }
      </tr>
    </tbody>
  </table>
</div>

<ul class="ic-cards">
  {
    PROJECT_COMPARISON_ROWS.map((row, index) => (
      <li class="ic-card">
        <h3 class="ic-card-title">{PROJECT_TYPE_LABELS[index].title}</h3>
        {fields.map((field) => (
          <div class="ic-card-field">
            <p class="ic-card-label">{field.label}</p>
            <p class="ic-card-value">
              {row[field.key].map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          </div>
        ))}
        <div class="ic-card-field">
          <p class="ic-card-label">了解專案</p>
          <a href={row.ctaHref} class="text-cta">
            {row.ctaLabel}
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </li>
    ))
  }
</ul>
