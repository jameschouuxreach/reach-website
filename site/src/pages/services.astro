---
/**
 * 服務內容總覽（第一層）：四個服務類別（2×2）→ 常見專案類型（探索型三卡＋優化型三卡）→ 收尾 CTA。
 * 2026-08-31 業主指示拿掉原頁首（H1＋導言），第一區標題升為本頁唯一 H1（2026-09-01 文案改為「四大專業面向，組合出適合你的專案」）。
 * 內容一律取自 src/data/services.ts；本頁不使用 ContactCta，收尾由 ProjectTypeGroups 的 showClosingCta 提供（§7.4、§8.1）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCategoryCard from '../components/services/ServiceCategoryCard.astro';
import ProjectTypeGroups from '../components/services/ProjectTypeGroups.astro';
import { SERVICE_CATEGORIES } from '../data/services';
---

<BaseLayout
  title="服務內容"
  description="致遠體驗設計以研究分析、體驗設計、品牌與服務策略及體驗顧問，依據問題、資源與發展階段組合適合的改善方法。"
>
  {/* ---- 四個服務類別（本頁 H1）---- */}
  <section class="bg-page">
    <div class="container-site py-16 md:py-24">
      <div class="max-w-3xl" data-reveal>
        <p class="flex items-baseline gap-3">
          <span class="text-base font-bold text-brand">服務項目</span>
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted" aria-hidden="true">OUR SERVICES</span>
        </p>
        <h1 class="heading-section mt-4">四大專業面向，組合出適合你的專案</h1>
        <p class="mt-4 text-lg leading-relaxed text-ink-secondary md:mt-5">
          我們會依照問題與情境，選擇真正必要的服務，而不是套用固定流程。
        </p>
      </div>
      <div class="mt-8 grid gap-6 md:mt-10 md:grid-cols-2" data-reveal>
        {SERVICE_CATEGORIES.map((category) => <ServiceCategoryCard {...category} headingLevel="h2" />)}
      </div>
    </div>
  </section>

  {/* ---- 常見專案類型＋收尾 CTA ---- */}
  <ProjectTypeGroups showIntro showClosingCta />
</BaseLayout>
