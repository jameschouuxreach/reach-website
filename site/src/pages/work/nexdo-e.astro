<script>
  /**
   * 總覽跳轉的無障礙增強（無 JS 時原生 hash 跳轉照常可用）：
   * 沿用原生 hash（保留瀏覽歷史、可複製深連結），下一幀把焦點移到目標段落的 H2，不另外捲動。
   */
  document.querySelectorAll<HTMLAnchorElement>('[data-ne-jump]').forEach((link) => {
    link.addEventListener('click', () => {
      const id = (link.getAttribute('href') ?? '').slice(1);
      const heading = id ? document.getElementById(id)?.querySelector<HTMLElement>('h2') : null;
      if (!heading) return;
      requestAnimationFrame(() => heading.focus({ preventScroll: true }));
    });
  });
</script>
