---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import TextLink from '../components/TextLink.astro';
import AudienceCard from '../components/AudienceCard.astro';
import CaseCard from '../components/CaseCard.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import ContactCta from '../components/ContactCta.astro';
import { CASES } from '../data/cases';
import { SITE_NAME, SITE_NAME_EN } from '../config';

const positioning = [
  {
    index: '01',
    title: '讓決策源自理解',
    body: '透過研究走進使用者的真實情境，理解問題如何發生，讓每一步都有脈絡可循。',
  },
  {
    index: '02',
    title: '讓全局清晰可見',
    body: '從使用者體驗到組織營運，我們梳理流程、角色及互動，找出能牽動全局的關鍵施力點。',
  },
  {
    index: '03',
    title: '讓改變真實發生',
    body: '理解多方需求與現實限制，在複雜組織中找到可行路徑，讓洞察落地、讓設計產生影響。',
  },
];
---

<BaseLayout
  title={`${SITE_NAME} ${SITE_NAME_EN}｜從複雜，致清晰`}
  description="致遠體驗設計透過研究、全局梳理與多方協作，陪政府與企業從複雜走向清晰，找出可落地的改善方向。"
  isHome
>
  {/* ---- 2. Hero：滿版海報式（自帶內距，不用 1160px 版心；其他區塊維持版心）---- */}
  <section class="bg-page">
    <div class="hero-band">
      <h1 class="heading-hero" data-reveal>
        <span class="block">從複雜，<span class="text-brand">致</span>清晰</span>
        <span class="mt-3 block"
          >陪你走得<span class="whitespace-nowrap"
            ><button
              type="button"
              class="hero-value-btn is-active"
              data-hero-value="deeper"
              aria-pressed="true">更深</button
            >、</span
          ><span class="whitespace-nowrap"
            ><button
              type="button"
              class="hero-value-btn"
              data-hero-value="wider"
              aria-pressed="false">更廣</button
            >、</span
          ><button type="button" class="hero-value-btn" data-hero-value="further" aria-pressed="false"
            >更遠</button
          ></span
        >
      </h1>

      <div
        class="hero-value-panel card mt-10 flex min-h-32 max-w-xl items-center p-7 md:mt-12 md:min-h-36 md:p-8"
        data-hero-value-panel
        aria-live="polite"
      >
        <p class="heading-sub" data-hero-value-text>讓決策源自理解</p>
      </div>
    </div>
  </section>

  {/* ---- 3. Why We Do／我們的使命 ---- */}
  <section class="border-t border-line">
    <div class="container-site pt-16 md:pt-24">
      <SectionLabel zh="我們的使命" en="WHY WE DO" />

      <div class="mt-10 grid gap-5 pb-16 sm:grid-cols-2 md:pb-24 lg:grid-cols-3">
        {
          positioning.map((item, i) => (
            <div class="card p-7" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
              <p class="text-sm font-bold text-brand" aria-hidden="true">
                {item.index}
              </p>
              <h3 class="mt-3 text-xl font-bold">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-secondary">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>

    {/* AI 主張：全站唯一大面積深色區塊 */}
    <div class="bg-dark">
      <div class="container-site py-20 text-center md:py-28" data-reveal>
        <h3 class="heading-section mx-auto max-w-4xl text-white">
          AI 讓產出<span class="text-emphasis">更快速</span>，我們讓成果<span class="text-emphasis"
            >更精準</span
          >
        </h3>
        <p class="mx-auto mt-6 max-w-2xl leading-loose text-white/85">
          AI 能快速產出，但產出的價值仍取決於對問題的理解深度。<br
            class="hidden md:inline"
          />我們結合 AI 的效率、使用者研究與全局判斷，讓成果真正回應需求。
        </p>
      </div>
    </div>
  </section>

  {/* ---- 4. What We Do／我們的服務 ---- */}
  <section class="bg-surface">
    <div class="container-site py-16 md:py-24">
      <SectionLabel zh="我們的服務" en="WHAT WE DO" />
      <div class="mt-10 grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div data-reveal>
          <h3 class="heading-sub max-w-xl">從未知到已知，讓改變有清楚的方向</h3>
          <p class="mt-5 max-w-xl leading-loose text-ink-secondary">
            面對複雜問題，我們從真實情境出發，結合研究、全局梳理與多方協作，釐清真正影響成效的關鍵，形成可執行的改善方向。
          </p>
          <p class="mt-8">
            <TextLink href="/services/" label="服務項目" />
          </p>
        </div>

        {/* A→B：散亂節點收斂為清晰路徑（裝飾圖，spec §5.3 指定） */}
        <div data-reveal>
          <svg
            viewBox="0 0 560 380"
            class="ab-visual h-auto w-full"
            role="img"
            aria-label="示意圖：左側散亂的節點逐步收斂為右側清晰的路徑，代表從尚未釐清的現象走向可決策、可行動的方向"
          >
            <text x="100" y="44" text-anchor="middle" class="ab-label">A</text>
            <text x="520" y="152" text-anchor="middle" class="ab-label">B</text>

            <g stroke="var(--neutral-200)" stroke-width="1">
              <line x1="52" y1="96" x2="128" y2="70"></line>
              <line x1="128" y1="70" x2="170" y2="120"></line>
              <line x1="170" y1="120" x2="120" y2="160"></line>
              <line x1="60" y1="180" x2="120" y2="160"></line>
              <line x1="52" y1="96" x2="120" y2="160"></line>
              <line x1="120" y1="160" x2="140" y2="246"></line>
              <line x1="72" y1="256" x2="140" y2="246"></line>
              <line x1="96" y1="310" x2="140" y2="246"></line>
              <line x1="60" y1="180" x2="72" y2="256"></line>
              <line x1="166" y1="296" x2="140" y2="246"></line>
            </g>

            <g fill="var(--neutral-400)">
              <circle cx="52" cy="96" r="5"></circle>
              <circle cx="128" cy="70" r="4"></circle>
              <circle cx="170" cy="120" r="6"></circle>
              <circle cx="60" cy="180" r="4"></circle>
              <circle cx="120" cy="160" r="7"></circle>
              <circle cx="176" cy="208" r="4"></circle>
              <circle cx="72" cy="256" r="5"></circle>
              <circle cx="140" cy="246" r="6"></circle>
              <circle cx="96" cy="310" r="4"></circle>
              <circle cx="166" cy="296" r="5"></circle>
            </g>

            <g fill="none" stroke="var(--neutral-300)" stroke-width="1.5">
              <path d="M170,120 C240,130 280,165 330,190"></path>
              <path d="M176,208 C240,205 280,195 330,190"></path>
              <path d="M140,246 C230,250 285,215 330,190"></path>
            </g>

            <path d="M330,190 L520,190" class="ab-main" fill="none" stroke="var(--reach-blue-500)" stroke-width="2.5"></path>

            <g class="ab-dots">
              <circle cx="366" cy="190" r="3" fill="var(--reach-blue-200)"></circle>
              <circle cx="402" cy="190" r="3.5" fill="var(--reach-blue-300)"></circle>
              <circle cx="438" cy="190" r="4" fill="var(--reach-blue-400)"></circle>
              <circle cx="474" cy="190" r="4.5" fill="var(--reach-blue-500)"></circle>
            </g>
            <circle cx="520" cy="190" r="9" fill="var(--reach-blue-500)"></circle>
          </svg>
        </div>
      </div>
    </div>
  </section>

  {/* ---- 5. 政府／企業客群分流 ---- */}
  <section class="border-y border-line bg-page">
    <div class="container-site py-16 md:py-24">
      <h2 class="sr-only">政府與企業入口</h2>
      <div class="grid gap-5 md:grid-cols-2" data-reveal>
        <AudienceCard
          pill="政府與公共服務"
          title="深耕數位公共服務，始終以民眾為本"
          body="我們熟悉政府標案、跨單位協作與既有系統限制，在民眾需要、政策目標與執行現實之間，找到真正可行的改善方向。"
          href="/public-sector/"
          ariaLabel="查看更多：政府與公共服務"
        />
        <AudienceCard
          pill="企業與服務團隊"
          title="找對問題，讓體驗改善轉為商業價值"
          body="從使用者、服務流程與組織全局中找出關鍵施力點，讓重大決策建立在理解之上。"
          href="/business/"
          ariaLabel="查看更多：企業與服務團隊"
        />
      </div>
    </div>
  </section>

  {/* ---- 6. 精選案例 ---- */}
  <section class="bg-surface">
    <div class="container-site py-16 md:py-24">
      <div class="flex flex-wrap items-baseline justify-between gap-4" data-reveal>
        <h2 class="heading-sub">精選案例</h2>
        <TextLink href="/cases/" label="所有案例" />
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4" data-reveal>
        {CASES.map((item) => <CaseCard {...item} />)}
      </div>
    </div>
  </section>

  {/* ---- 7. 信任與合作 ---- */}
  <section class="border-t border-line bg-page">
    <h2 class="sr-only">信任與合作</h2>

    {/* Reach 品牌動態：桌機 sticky scroll 版 */}
    <div class="reach-desktop relative" data-reach-desktop>
      <div class="absolute inset-0" aria-hidden="true">
        {[0, 1, 2, 3, 4].map((i) => <div class="h-1/5" data-reach-step={i}></div>)}
      </div>
      <div class="sticky top-0 flex h-screen items-center">
        <div class="container-site">
          <p class="reach-word text-brand">Reach</p>
          <div class="reach-phrases relative" aria-live="polite">
            <p class="reach-phrase is-current" data-reach-phrase>deeper understanding</p>
            <p class="reach-phrase" data-reach-phrase>the bigger picture</p>
            <p class="reach-phrase" data-reach-phrase>lasting change</p>
            <p class="reach-phrase" data-reach-phrase>better experiences</p>
            <p class="reach-phrase" data-reach-phrase>Experience Design</p>
          </div>
          <p class="reach-caption mt-6 text-lg font-semibold text-ink-secondary">致遠體驗設計</p>
        </div>
      </div>
    </div>

    {/* Reach 品牌動態：行動版／reduced-motion 靜態版 */}
    <div class="reach-static">
      <div class="container-site pt-16 md:pt-24">
        <ul class="space-y-3">
          {
            ['deeper understanding', 'the bigger picture', 'lasting change', 'better experiences'].map(
              (phrase, i) => (
                <li
                  class="text-2xl font-bold leading-snug md:text-3xl"
                  data-reveal
                  style={`--reveal-delay: ${i * 80}ms`}
                >
                  <span class="text-brand">Reach</span> <span class="text-ink">{phrase}</span>
                </li>
              ),
            )
          }
        </ul>
        <p class="mt-10 border-t border-line pt-8 text-3xl font-bold md:text-4xl" data-reveal>
          <span class="text-brand">Reach</span> Experience Design
          <span class="mt-2 block text-base font-semibold text-ink-secondary">致遠體驗設計</span>
        </p>
      </div>
    </div>

    {/* 合作對象 Logo */}
    <div class="container-site pb-16 pt-16 md:pb-24" data-reveal>
      <PartnerLogos />
    </div>
  </section>

  {/* ---- 8. 最終聯絡 CTA ---- */}
  <ContactCta />

  <script>
    import '../scripts/hero-values';
    import '../scripts/reach-scroll';
  </script>
</BaseLayout>

<style>
  /* ---- 滿版 Hero：內距約 80px（5.5vw 封頂），桌機高度撐到視窗高扣掉 header ---- */
  .hero-band {
    padding-inline: clamp(1.25rem, 5.5vw, 5rem);
    padding-block: 5rem 4rem;
  }

  @media (min-width: 768px) {
    .hero-band {
      display: flex;
      flex-direction: column;
      justify-content: center;
      /* header 桌機高 72px；svh 避免行動瀏覽器網址列造成跳動 */
      min-height: calc(100svh - 4.5rem);
      padding-block: 3rem;
    }
  }

  /* Hero 可互動詞：品牌藍文字；選中同步具備淡藍底色＋底線（不只靠顏色） */
  .hero-value-btn {
    font: inherit;
    color: var(--color-brand);
    padding-inline: 0.06em;
    border-radius: 0.14em;
    border-bottom: 0.08em solid transparent;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .hero-value-btn:hover {
    background-color: var(--reach-blue-50);
  }

  .hero-value-btn.is-active {
    background-color: var(--reach-blue-100);
    border-bottom-color: var(--color-brand);
  }

  .hero-value-btn:focus-visible {
    outline: 2px solid var(--reach-blue-300);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-value-btn {
      transition: none;
    }
  }

  /* ---- A→B 收斂視覺：進場時藍色路徑輕微繪製（500–800ms，僅此一個動畫焦點） ---- */
  .ab-visual {
    max-width: 560px;
  }

  .ab-label {
    font-size: 15px;
    font-weight: 700;
    fill: var(--neutral-500);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ab-main {
      stroke-dasharray: 200;
      stroke-dashoffset: 200;
      transition: stroke-dashoffset 700ms ease 250ms;
    }

    :global(html.js) [data-reveal].is-visible .ab-main {
      stroke-dashoffset: 0;
    }

    :global(html.js) .ab-dots circle {
      opacity: 0;
      transition: opacity 400ms ease;
    }

    :global(html.js) [data-reveal].is-visible .ab-dots circle {
      opacity: 1;
    }

    :global(html.js) [data-reveal].is-visible .ab-dots circle:nth-child(1) { transition-delay: 350ms; }
    :global(html.js) [data-reveal].is-visible .ab-dots circle:nth-child(2) { transition-delay: 500ms; }
    :global(html.js) [data-reveal].is-visible .ab-dots circle:nth-child(3) { transition-delay: 650ms; }
    :global(html.js) [data-reveal].is-visible .ab-dots circle:nth-child(4) { transition-delay: 800ms; }
  }

  /* ---- Reach 品牌動態 ----
     預設顯示靜態版；桌機＋允許動態＋JS 可用時才啟用 sticky 版。 */
  .reach-desktop {
    display: none;
  }

  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .reach-desktop {
      display: block;
      height: 280vh; /* 規格 §5.6：整區約 240–320vh */
    }

    :global(html.js) .reach-static {
      display: none;
    }
  }

  .reach-word,
  .reach-phrase {
    font-size: clamp(2.5rem, 1.1rem + 4.6vw, 4.25rem);
    line-height: 1.2;
    font-weight: 700;
  }

  .reach-phrases {
    height: 1.25em;
    font-size: clamp(2.5rem, 1.1rem + 4.6vw, 4.25rem);
  }

  .reach-phrase {
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    margin: 0;
    white-space: nowrap;
    color: var(--color-text);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 240ms ease, transform 240ms ease;
  }

  .reach-phrase.is-current {
    opacity: 1;
    transform: none;
  }

  /* 收束狀態：品牌名稱作為明確的最終停留 */
  .reach-caption {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 240ms ease 120ms, transform 240ms ease 120ms;
  }

  .reach-desktop.is-final .reach-caption {
    opacity: 1;
    transform: none;
  }
</style>
