---
/**
 * 企業與服務團隊內頁（2026-10-01 規格 doc/開發規格/business-v1）：
 * Hero → 痛點 3 列圖文 → 解法 3 列圖文 → 單一 CTA（相關案例區塊 2026-10-07 依業主指示移除）。
 * 版面比照公共服務頁的逐列圖文與 CTA；本頁單一受眾，不設 Tab，也不需要額外 JavaScript。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import IllustratedPoint from '../components/business/IllustratedPoint.astro';
import BusinessCta from '../components/business/BusinessCta.astro';
import {
  BUSINESS_HERO,
  BUSINESS_PAIN_HEADING,
  BUSINESS_PAINS,
  BUSINESS_SOLUTION_HEADING,
  BUSINESS_SOLUTIONS,
} from '../data/business';
---

<BaseLayout
  title="企業與服務團隊"
  description="致遠體驗設計協助企業從使用者、服務流程與組織全局中找出關鍵施力點，讓體驗改善轉為商業價值。"
>
  <PageHero title={BUSINESS_HERO.title} intro={BUSINESS_HERO.intro} />

  {/* 圖文區白底：插圖為不透明白底 PNG，避免在灰底上出現硬矩形 */}
  <div class="bg-surface">
    <section class="container-site py-12 md:py-20" aria-labelledby="biz-pain-heading">
      <h2 id="biz-pain-heading" class="biz-section-title">{BUSINESS_PAIN_HEADING}</h2>
      <div class="biz-points">
        {BUSINESS_PAINS.map((point, index) => <IllustratedPoint {...point} eager={index === 0} />)}
      </div>
    </section>
    <div class="border-t border-line">
      <section class="container-site py-12 md:py-20" aria-labelledby="biz-solution-heading">
        <h2 id="biz-solution-heading" class="biz-section-title">{BUSINESS_SOLUTION_HEADING}</h2>
        <div class="biz-points">
          {BUSINESS_SOLUTIONS.map((point) => <IllustratedPoint {...point} />)}
        </div>
      </section>
    </div>
  </div>

  <BusinessCta />
</BaseLayout>

<style>
  /* 比照 public-sector.astro 的 ps-section-title／ps-points */
  .biz-section-title {
    font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.25rem); /* 手機 26px → 桌機 36px */
    line-height: 1.4;
  }

  .biz-points {
    display: grid;
    gap: 3rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .biz-points {
      gap: 4rem;
      margin-top: 3.5rem;
    }
  }
</style>
