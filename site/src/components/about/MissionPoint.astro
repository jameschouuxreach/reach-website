---
/**
 * 關於頁「我們的使命」的一列：標題（品牌詞＋大標合併一行，同為黑色；2026-10-05 業主指示由品牌藍改黑）＋內文＋案例連結文字（左）、原版九宮格動畫 GIF（右）；
 * 手機單欄先文後圖。版型比照政府頁 IllustratedPoint。GIF 沿用 MissionScrollStory 九宮格幾何逐幀輸出（白底，2026-10-05 v2）：
 * 01 中心品牌藍點＋外圍淺藍點（blue-200）順時針逐一出現 → 02 淺藍連線 → 03 外圍點與連線轉為品牌藍（blue-500）；
 * reduced-motion 改用同名 PNG 終態。圖示輔助相鄰正文，alt 留空。
 */
import type { MissionItem } from '../../data/mission';

interface Props {
  item: MissionItem;
  /** 只有第一列 eager，其餘 lazy */
  eager?: boolean;
  /** 桌機左右交換（圖左文右）；手機一律先文後圖 */
  reverse?: boolean;
}

const { item, eager = false, reverse = false } = Astro.props;
const src = `/images/about/mission-${item.index}`;
/** 在第一個逗號後斷成兩行：案例連結文字（業主指示）；標題同理（欄寬 340px 放不下一行，避免自然折行斷在詞中） */
function splitAtComma(text: string): [string, string] {
  const at = text.indexOf('，');
  return at === -1 ? [text, ''] : [text.slice(0, at + 1), text.slice(at + 1)];
}
const [linkHead, linkTail] = splitAtComma(item.caseLink.text);
const [titleHead, titleTail] = splitAtComma(item.title);
---

<article class:list={['mp', reverse && 'mp-reverse']}>
  <div class="mp-text">
    <h3 class="mp-title">
      {item.word}<span class="mp-sep" aria-hidden="true">｜</span>{titleHead}{titleTail && <br />}{titleTail}
    </h3>
    <p class="mp-body">{item.body}</p>
    <a href={item.caseLink.href} class="mp-link">
      {linkHead}{linkTail && <br />}{linkTail}<span class="mp-arrow" aria-hidden="true">&nbsp;→</span>
    </a>
  </div>
  <div class="mp-media">
    <picture>
      <source srcset={`${src}.png`} media="(prefers-reduced-motion: reduce)" />
      <img
        src={`${src}.gif`}
        alt=""
        width="720"
        height="720"
        decoding="async"
        loading={eager ? 'eager' : 'lazy'}
      />
    </picture>
  </div>
</article>

<style>
  /* 交錯對齊（業主指示）：兩欄等寬，文字與 GIF 點陣各自撐滿所在欄，
     故「更廣」的點陣左右緣＝「更深／更遠」文字欄左右緣，「更廣」文字欄＝「更深／更遠」點陣左右緣 */
  .mp {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .mp {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
    }

    .mp-reverse .mp-media {
      order: -1;
    }
  }

  /* 桌機：兩欄固定為 GIF 原尺寸（340px），左右貼齊內容區兩側，剩餘空間全給中間欄距（文字與 GIF 拉開） */
  @media (min-width: 1024px) {
    .mp {
      grid-template-columns: repeat(2, minmax(0, 340px));
      justify-content: space-between;
      gap: 4rem;
    }
  }

  .mp-title {
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem); /* 手機 22px → 桌機 28px，同政府頁 */
    font-weight: 700;
    line-height: 1.45;
  }

  .mp-body {
    margin-top: 0.875rem;
    color: var(--color-ink-secondary);
    line-height: 1.8;
  }

  .mp-sep {
    color: var(--color-ink-soft);
    font-weight: 400;
  }

  /* 案例連結文字：品牌連結色、粗體，hover 底線；箭頭不換行跟在句尾 */
  .mp-link {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-link);
    font-weight: 700;
    line-height: 1.7;
    text-decoration: none;
  }

  .mp-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mp-arrow {
    display: inline-block;
    white-space: nowrap;
    transition: transform 0.2s ease;
  }

  .mp-link:hover .mp-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .mp-arrow {
      transition: none;
    }
  }

  /* GIF 畫布＝點陣外緣再加每側 10 單位留白（回彈＋線寬；點陣寬 598、畫布 618，見 GIF 產生腳本），
     圖片放大 618/598 並左移 10/598，讓點陣外緣剛好落在欄位邊緣 */
  .mp-media {
    width: 100%;
    max-width: 340px; /* 手機單欄時限寬 */
  }

  @media (min-width: 768px) {
    .mp-media {
      max-width: none;
    }
  }

  .mp-media img {
    display: block;
    width: calc(100% * 618 / 598);
    max-width: none;
    height: auto;
    margin-left: calc(-100% * 10 / 598);
  }
</style>
