---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import TextLink from '../components/TextLink.astro';
import AudienceCard from '../components/AudienceCard.astro';
import CaseCard from '../components/CaseCard.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import ContactCta from '../components/ContactCta.astro';
import { CASES } from '../data/cases';
import { SITE_NAME, SITE_NAME_EN } from '../config';

const positioning = [
  {
    index: '01',
    title: '讓決策源自理解',
    body: '透過研究走進使用者的真實情境，理解問題如何發生，讓每一步都有脈絡可循。',
  },
  {
    index: '02',
    title: '讓全局清晰可見',
    body: '從使用者體驗到組織營運，我們梳理流程、角色及互動，找出能牽動全局的關鍵施力點。',
  },
  {
    index: '03',
    title: '讓改變真實發生',
    body: '理解多方需求與現實限制，在複雜組織中找到可行路徑，讓洞察落地、讓設計產生影響。',
  },
];
---

<BaseLayout
  title={`${SITE_NAME} ${SITE_NAME_EN}｜從複雜，致清晰`}
  description="致遠體驗設計透過研究、全局梳理與多方協作，陪政府與企業從複雜走向清晰，找出可落地的改善方向。"
  isHome
>
  {/* ---- 2. Hero：滿版海報式＋四幕輪播（v1.1）。左欄中文主標打字輪替，右欄 Reach 句同步切換 ---- */}
  <section class="bg-page">
    <div class="hero-band" data-hc>
      <div class="hero-grid" data-reveal>
        {/* 左欄：主標（單一 H1；朗讀內容固定，動畫層 aria-hidden） */}
        <h1 class="heading-hero relative" data-hc-stage>
          <span class="sr-only">從複雜，致清晰，陪你走得更深、更廣、更遠。致遠體驗設計。</span>

          {/* 靜態備援：無 JS 或 reduced-motion 時顯示 */}
          <span class="hc-static" aria-hidden="true">
            <span class="block">從複雜，<span class="text-brand">致</span>清晰</span>
            <span class="mt-3 block">陪你走得更深、更廣、更<span class="text-brand">遠</span></span>
          </span>

          {/* 輪播動畫層 */}
          <span class="hc-anim" aria-hidden="true">
            <span class="hc-line block" data-hc-line1
              >從複雜，<span class="text-brand" data-hc-zhi>致</span>清晰</span
            >
            <span class="hc-line mt-3 block" data-hc-line2
              >陪你走得更<span class="hc-slot text-brand" data-hc-slot>深</span><span
                class="hc-caret"
                data-hc-caret></span></span
            >
            {/* 第四幕：致遠合併後打出「體驗設計」 */}
            <span class="hc-brand" data-hc-brand
              ><span class="text-brand" data-hc-brand-zhi>致</span><span
                class="text-brand"
                data-hc-brand-yuan>遠</span
              ><span data-hc-brand-rest></span><span class="hc-caret hc-caret-brand" data-hc-brand-caret
              ></span></span
            >
          </span>
        </h1>

        {/* 右欄：Reach 句＋對應中文句（無卡片外框） */}
        <div class="hc-right">
          <p class="sr-only">
            Reach deeper understanding，讓決策源自理解。Reach the bigger
            picture，讓全局清晰可見。Reach lasting change，讓改變真實發生。Reach better
            experiences。
          </p>

          {/* 靜態備援 */}
          <div class="hc-static" aria-hidden="true">
            <p class="hc-en-static"><span class="text-brand">Reach</span> deeper understanding</p>
            <p class="hc-en-static"><span class="text-brand">Reach</span> the bigger picture</p>
            <p class="hc-en-static"><span class="text-brand">Reach</span> lasting change</p>
            <p class="hc-en-static"><span class="text-brand">Reach</span> better experiences</p>
          </div>

          {/* 輪播動畫層：Reach 固定不動；詞組與中文句垂直滑動輪替（舊字上滑出、新字下方進） */}
          <div class="hc-anim hc-right-anim" aria-hidden="true">
            <p class="hc-en"><span class="text-brand">Reach</span></p>
            <div class="hc-en hc-slide" data-hc-phrase>
              <span class="hc-slide-item is-current">deeper understanding</span>
              <span class="hc-slide-item">the bigger picture</span>
              <span class="hc-slide-item">lasting change</span>
              <span class="hc-slide-item">better experiences</span>
            </div>
            <div class="hc-zh hc-slide" data-hc-zh>
              <span class="hc-slide-item is-current">讓決策源自理解</span>
              <span class="hc-slide-item">讓全局清晰可見</span>
              <span class="hc-slide-item">讓改變真實發生</span>
              <span class="hc-slide-item"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---- 3. Why We Do／我們的使命 ---- */}
  <section class="border-t border-line">
    <div class="container-site pt-16 md:pt-24">
      <SectionLabel zh="我們的使命" en="WHY WE DO" />

      <div class="mt-10 grid gap-5 pb-16 sm:grid-cols-2 md:pb-24 lg:grid-cols-3">
        {
          positioning.map((item, i) => (
            <div class="card p-7" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
              <p class="text-sm font-bold text-brand" aria-hidden="true">
                {item.index}
              </p>
              <h3 class="mt-3 text-xl font-bold">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-secondary">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>

    {/* AI 主張：全站唯一大面積深色區塊 */}
    <div class="bg-dark">
      <div class="container-site py-20 text-center md:py-28" data-reveal>
        <h3 class="heading-section mx-auto max-w-4xl text-white">
          AI 讓產出<span class="text-emphasis">更快速</span>，我們讓成果<span class="text-emphasis"
            >更精準</span
          >
        </h3>
        <p class="mx-auto mt-6 max-w-2xl leading-loose text-white/85">
          AI 能快速產出，但產出的價值仍取決於對問題的理解深度。<br
            class="hidden md:inline"
          />我們結合 AI 的效率、使用者研究與全局判斷，讓成果真正回應需求。
        </p>
      </div>
    </div>
  </section>

  {/* ---- 4. What We Do／我們的服務 ---- */}
  <section class="bg-surface">
    <div class="container-site py-16 md:py-24">
      <SectionLabel zh="我們的服務" en="WHAT WE DO" />
      <div class="mt-10 grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div data-reveal>
          <h3 class="heading-sub max-w-xl">從未知到已知，讓改變有清楚的方向</h3>
          <p class="mt-5 max-w-xl leading-loose text-ink-secondary">
            面對複雜問題，我們從真實情境出發，結合研究、全局梳理與多方協作，釐清真正影響成效的關鍵，形成可執行的改善方向。
          </p>
          <p class="mt-8">
            <TextLink href="/services/" label="服務項目" />
          </p>
        </div>

        {/* A→B：散亂節點收斂為清晰路徑（裝飾圖，spec §5.3 指定） */}
        <div data-reveal>
          <svg
            viewBox="0 0 560 380"
            class="ab-visual h-auto w-full"
            role="img"
            aria-label="示意圖：左側散亂的節點逐步收斂為右側清晰的路徑，代表從尚未釐清的現象走向可決策、可行動的方向"
          >
            <text x="100" y="44" text-anchor="middle" class="ab-label">A</text>
            <text x="520" y="152" text-anchor="middle" class="ab-label">B</text>

            <g stroke="var(--neutral-200)" stroke-width="1">
              <line x1="52" y1="96" x2="128" y2="70"></line>
              <line x1="128" y1="70" x2="170" y2="120"></line>
              <line x1="170" y1="120" x2="120" y2="160"></line>
              <line x1="60" y1="180" x2="120" y2="160"></line>
              <line x1="52" y1="96" x2="120" y2="160"></line>
              <line x1="120" y1="160" x2="140" y2="246"></line>
              <line x1="72" y1="256" x2="140" y2="246"></line>
              <line x1="96" y1="310" x2="140" y2="246"></line>
              <line x1="60" y1="180" x2="72" y2="256"></line>
              <line x1="166" y1="296" x2="140" y2="246"></line>
            </g>

            <g fill="var(--neutral-400)">
              <circle cx="52" cy="96" r="5"></circle>
              <circle cx="128" cy="70" r="4"></circle>
              <circle cx="170" cy="120" r="6"></circle>
              <circle cx="60" cy="180" r="4"></circle>
              <circle cx="120" cy="160" r="7"></circle>
              <circle cx="176" cy="208" r="4"></circle>
              <circle cx="72" cy="256" r="5"></circle>
              <circle cx="140" cy="246" r="6"></circle>
              <circle cx="96" cy="310" r="4"></circle>
              <circle cx="166" cy="296" r="5"></circle>
            </g>

            <g fill="none" stroke="var(--neutral-300)" stroke-width="1.5">
              <path d="M170,120 C240,130 280,165 330,190"></path>
              <path d="M176,208 C240,205 280,195 330,190"></path>
              <path d="M140,246 C230,250 285,215 330,190"></path>
            </g>

            <path d="M330,190 L520,190" class="ab-main" fill="none" stroke="var(--reach-blue-500)" stroke-width="2.5"></path>

            <g class="ab-dots">
              <circle cx="366" cy="190" r="3" fill="var(--reach-blue-200)"></circle>
              <circle cx="402" cy="190" r="3.5" fill="var(--reach-blue-300)"></circle>
              <circle cx="438" cy="190" r="4" fill="var(--reach-blue-400)"></circle>
              <circle cx="474" cy="190" r="4.5" fill="var(--reach-blue-500)"></circle>
            </g>
            <circle cx="520" cy="190" r="9" fill="var(--reach-blue-500)"></circle>
          </svg>
        </div>
      </div>
    </div>
  </section>

  {/* ---- 5. 政府／企業客群分流 ---- */}
  <section class="border-y border-line bg-page">
    <div class="container-site py-16 md:py-24">
      <h2 class="sr-only">政府與企業入口</h2>
      <div class="grid gap-5 md:grid-cols-2" data-reveal>
        <AudienceCard
          pill="政府與公共服務"
          title="深耕數位公共服務，始終以民眾為本"
          body="我們熟悉政府標案、跨單位協作與既有系統限制，在民眾需要、政策目標與執行現實之間，找到真正可行的改善方向。"
          href="/public-sector/"
          ariaLabel="查看更多：政府與公共服務"
        />
        <AudienceCard
          pill="企業與服務團隊"
          title="找對問題，讓體驗改善轉為商業價值"
          body="從使用者、服務流程與組織全局中找出關鍵施力點，讓重大決策建立在理解之上。"
          href="/business/"
          ariaLabel="查看更多：企業與服務團隊"
        />
      </div>
    </div>
  </section>

  {/* ---- 6. 精選案例 ---- */}
  <section class="bg-surface">
    <div class="container-site py-16 md:py-24">
      <div class="flex flex-wrap items-baseline justify-between gap-4" data-reveal>
        <h2 class="heading-sub">精選案例</h2>
        <TextLink href="/cases/" label="所有案例" />
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4" data-reveal>
        {CASES.map((item) => <CaseCard {...item} />)}
      </div>
    </div>
  </section>

  {/* ---- 7. 信任與合作（v1.1：Reach 品牌動態併入 Hero，此區保留合作 Logo）---- */}
  <section class="border-t border-line bg-page">
    <h2 class="sr-only">信任與合作</h2>
    <div class="container-site py-16 md:py-24" data-reveal>
      <PartnerLogos />
    </div>
  </section>

  {/* ---- 8. 最終聯絡 CTA ---- */}
  <ContactCta />

  <script>
    import '../scripts/hero-carousel';
  </script>
</BaseLayout>

<style>
  /* ---- 滿版 Hero：內距約 80px（5.5vw 封頂），桌機高度撐到視窗高扣掉 header ---- */
  .hero-band {
    padding-inline: clamp(1.25rem, 5.5vw, 5rem);
    padding-block: 5rem 4rem;
  }

  @media (min-width: 768px) {
    .hero-band {
      display: flex;
      flex-direction: column;
      justify-content: center;
      /* header 桌機高 72px；svh 避免行動瀏覽器網址列造成跳動 */
      min-height: calc(100svh - 4.5rem);
      padding-block: 3rem;
    }
  }

  /* ---- Hero 兩欄 ----
     --hero-fs 與 .heading-hero 的 clamp 公式一致，右欄字級按比例推導以維持左右等高 */
  .hero-grid {
    --hero-fs: clamp(2.5rem, 5.6vw - 3px, 4.4rem);
    display: grid;
    gap: 2.75rem;
    align-items: center;
    transition: opacity 440ms ease;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 3rem;
    }

    /* 右欄撐滿列高（列高由左欄 H1 決定），三行以 space-between 對齊上下緣 */
    .hc-right {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  [data-hc].is-resetting .hero-grid {
    opacity: 0;
  }

  /* ---- 輪播／靜態備援切換：預設靜態，JS＋允許動態時啟用輪播 ---- */
  .hc-static {
    display: block;
  }

  .hc-anim {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hc-anim {
      display: block;
    }

    :global(html.js) .hc-static {
      display: none;
    }
  }

  /* ---- 左欄動畫層 ---- */
  .hc-line {
    transition: opacity 300ms ease;
  }

  .hc-line.is-faded {
    opacity: 0;
  }

  .is-ghost {
    visibility: hidden;
  }

  /* 打字格固定 1em 寬，刪改期間不產生位移 */
  .hc-slot {
    display: inline-block;
    width: 1em;
  }

  /* 游標：打字時恆亮、停頓時閃爍 */
  .hc-caret {
    display: inline-block;
    width: 3px;
    height: 0.92em;
    margin-left: 0.05em;
    vertical-align: -0.06em;
    background-color: var(--color-brand);
    animation: hc-blink 1.1s steps(1) infinite;
  }

  .hc-caret.is-typing {
    animation: none;
    opacity: 1;
  }

  .hc-caret.is-hidden {
    animation: none;
    opacity: 0;
  }

  @keyframes hc-blink {
    0%,
    54% {
      opacity: 1;
    }
    55%,
    100% {
      opacity: 0;
    }
  }

  /* 第四幕品牌行：疊在第一行位置，等致遠合併後顯示 */
  .hc-brand {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 140ms ease;
    pointer-events: none;
  }

  .hc-brand.is-shown {
    opacity: 1;
  }

  .hc-caret-brand {
    animation: none;
    opacity: 0;
  }

  .hc-caret-brand.is-visible {
    animation: hc-blink 1.1s steps(1) infinite;
    opacity: 1;
  }

  .hc-caret-brand.is-typing {
    animation: none;
    opacity: 1;
  }

  /* FLIP 飛行字（致、遠）：由 JS 建立，繼承 h1 字體樣式 */
  :global(.hc-clone) {
    position: absolute;
    margin: 0;
    color: var(--color-brand);
    transition: transform 580ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    pointer-events: none;
  }

  /* ---- 右欄（v1.1.2：三行結構 Reach／詞組／中文句，與左欄 H1 等高）---- */
  .hc-right-anim {
    gap: 0.375rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hc-right-anim {
      display: flex;
      flex-direction: column;
    }
  }

  @media (min-width: 768px) {
    .hc-right-anim {
      flex: 1;
      justify-content: space-between;
    }
  }

  .hc-en {
    font-size: 2rem;
    line-height: 1.25;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .hc-zh {
    font-size: 1.375rem;
    line-height: 1.5;
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    /* 由主標字級推導：2 行英文（lh1.25×0.6）＋1 行中文（lh1.5×0.43）＋間距
       恆小於等於左欄兩行高度，等高由 stretch＋space-between 保證 */
    .hc-en {
      font-size: calc(var(--hero-fs) * 0.6);
    }

    .hc-zh {
      font-size: calc(var(--hero-fs) * 0.43);
    }
  }

  /* 垂直滑動字槽：舊字上滑出、新字自下方進（機制同 Animate UI「Rotating Text」，原生實作） */
  .hc-slide {
    position: relative;
    overflow: hidden;
    height: 1.25em;
  }

  .hc-zh.hc-slide {
    height: 1.5em;
  }

  .hc-slide-item {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(130%);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1), opacity 320ms ease;
  }

  .hc-slide-item.is-current {
    opacity: 1;
    transform: none;
  }

  .hc-slide-item.is-leaving {
    opacity: 0;
    transform: translateY(-130%);
  }

  .hc-slide-item.no-anim {
    transition: none;
  }

  /* 靜態備援（無 JS／reduced-motion） */
  .hc-en-static {
    font-size: clamp(1.875rem, 1.5rem + 1.5vw, 2.4375rem);
    line-height: 1.3;
    font-weight: 600;
    color: var(--color-text);
  }

  .hc-en-static + .hc-en-static {
    margin-top: 0.75rem;
  }

  /* ---- A→B 收斂視覺：進場時藍色路徑輕微繪製（500–800ms，僅此一個動畫焦點） ---- */
  .ab-visual {
    max-width: 560px;
  }

  .ab-label {
    font-size: 15px;
    font-weight: 700;
    fill: var(--neutral-500);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ab-main {
      stroke-dasharray: 200;
      stroke-dashoffset: 200;
      transition: stroke-dashoffset 700ms ease 250ms;
    }

    :global(html.js) [data-reveal].is-visible .ab-main {
      stroke-dashoffset: 0;
    }

    :global(html.js) .ab-dots circle {
      opacity: 0;
      transition: opacity 400ms ease;
    }

    :global(html.js) [data-reveal].is-visible .ab-dots circle {
      opacity: 1;
    }

    :global(html.js) [data-reveal].is-visible .ab-dots circle:nth-child(1) { transition-delay: 350ms; }
    :global(html.js) [data-reveal].is-visible .ab-dots circle:nth-child(2) { transition-delay: 500ms; }
    :global(html.js) [data-reveal].is-visible .ab-dots circle:nth-child(3) { transition-delay: 650ms; }
    :global(html.js) [data-reveal].is-visible .ab-dots circle:nth-child(4) { transition-delay: 800ms; }
  }

</style>
