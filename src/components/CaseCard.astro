---
/**
 * 案例卡（v2.0）：獨立圖片 → 大標題 → 摘要 → 專案類型 pills；hover 時標題轉品牌色。
 * eyebrow／cta 欄位保留但不顯示；kicker 提供時顯示為標題上方的品牌色小標。未提供 image 時維持灰階佔位框，
 * 未提供 href 時為純展示卡（不可點）。
 */
interface Props {
  name: string;
  /** 客戶類別（v1.7b 版式上不顯示，保留資料欄位） */
  tag?: string;
  types?: string[];
  mediaNote?: string;
  /** 客戶名稱小標（v2.0 版式上不顯示，保留資料欄位） */
  eyebrow?: string;
  /** 標題上方的品牌色小標（v2.3 新增，僅提供時顯示） */
  kicker?: string;
  /** 卡片摘要 */
  summary?: string;
  /** 卡片圖片（提供後取代佔位框） */
  image?: { src: string; alt: string };
  /** 內頁連結（提供後整卡可點） */
  href?: string;
  /** CTA 文字（v2.0 版式上不顯示，保留資料欄位） */
  cta?: string;
}

const {
  name,
  types = ['案例整理中'],
  mediaNote = '需要素材：專案代表圖或研究現場照片',
  summary,
  kicker,
  image,
  href,
} = Astro.props;

const Wrapper = href ? 'a' : 'article';
const wrapperProps = href
  ? { href, class: 'case-card group block no-underline' }
  : { class: 'case-card' };
---

<Wrapper {...wrapperProps}>
  {
    image ? (
      <div class="overflow-hidden rounded-xl border border-line">
        <img
          src={image.src}
          alt={image.alt}
          width="1440"
          height="900"
          loading="lazy"
          class="case-card-img aspect-[16/10] w-full object-cover object-top"
        />
      </div>
    ) : (
      <div class="media-placeholder aspect-[16/10] rounded-xl">{mediaNote}</div>
    )
  }
  {kicker && <p class="mt-6 text-sm font-bold tracking-wide text-brand">{kicker}</p>}
  <h3 class:list={['case-title text-xl font-bold text-ink md:text-2xl', kicker ? 'mt-2' : 'mt-6']}>{name}</h3>
  {summary && <p class="mt-3 leading-relaxed text-ink-secondary">{summary}</p>}
  <p class="mt-4 flex flex-wrap gap-2">
    {
      types.map((type) => (
        <span class="rounded-full border border-line bg-surface px-3.5 py-1 text-sm text-ink-secondary">
          {type}
        </span>
      ))
    }
  </p>
</Wrapper>

<style>
  .case-card-img {
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  a.case-card:hover .case-card-img,
  a.case-card:focus-visible .case-card-img {
    transform: scale(1.03);
  }

  a.case-card:focus-visible {
    outline: 2px solid var(--reach-blue-300);
    outline-offset: 4px;
    border-radius: 12px;
  }

  .case-title {
    transition: color 200ms ease;
  }

  a.case-card:hover .case-title,
  a.case-card:focus-visible .case-title {
    color: var(--color-brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .case-card-img,
    .case-title {
      transition: none;
    }

    a.case-card:hover .case-card-img,
    a.case-card:focus-visible .case-card-img {
      transform: none;
    }
  }
</style>
