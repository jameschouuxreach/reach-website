---
/**
 * 好齡居專案實例｜版本 C：小瑜觀點版。
 * 依《好齡居專案實例-版本C-小瑜觀點版.md》製作：Our Approach 前置＋頁內錨點、
 * 四個策略章節皆以「Before／我們如何判斷／After」呈現、研究圖表重製為網頁原生圖；
 * 預設不公開研究規模數字與族群百分比，不宣稱未驗證的商業成效。
 * 現行網站截圖擷取日期：2026-08-26（檔名帶日期）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const CAPTURE_DATE = '2026 年 8 月 26 日';

const INFO = ['受眾研究', '品牌與服務定位', '資訊架構重整', '網站與內容策略', '2026'];

const APPROACH = [
  {
    num: '01',
    name: '受眾研究',
    desc: '用問卷掌握需求分布，再透過深度訪談理解子女與長輩的購買動機、顧慮與互動關係。',
    href: '#research',
    link: '前往研究發現',
  },
  {
    num: '02',
    name: '品牌與服務定位',
    desc: '重新界定主要服務對象、品牌角色與服務分類，讓好齡居不再只是多種服務的集合。',
    href: '#brand',
    link: '前往定位策略',
  },
  {
    num: '03',
    name: '網站架構',
    desc: '把原本依公司內部分工排列的服務，改成使用者能從生活問題開始理解的入口。',
    href: '#architecture',
    link: '前往網站策略',
  },
  {
    num: '04',
    name: '內容治理',
    desc: '將研究洞察整理成可持續使用的寫作原則，再讓 AI 協助檢查內容是否偏離品牌定位。',
    href: '#content',
    link: '前往內容策略',
  },
];

const RESEARCH_FLOW = ['問卷掌握需求分布', '訪談理解關係與原因', '收斂受眾及策略方向'];

const OLD_CATEGORIES = ['居家照護', '適老換屋', '居家改造', '關懷陪伴'];
const NEW_CATEGORIES = ['居住安全', '清潔收納', '租房搬家', '樂齡健康'];

const TRAIT_LAYERS = [
  { label: '服務基本盤', traits: ['專業', '完善'], note: '讓子女相信服務可靠、判斷有依據' },
  { label: '進入家庭的方式', traits: ['溫暖', '彈性', '共創'], note: '讓長輩感受到自己仍參與決定' },
];

const STAGES = [
  { num: '01', name: '建立印象', desc: '先以生活轉折與陪伴建立關聯，讓人確認品牌理解自己的情境。', block: '首頁 Hero' },
  { num: '02', name: '理解服務', desc: '從生活問題進入服務入口，再認識延伸服務。', block: '我們提供／我們還提供' },
  { num: '03', name: '取得信任', desc: '以真實故事與品牌內容降低第一次接觸的疑慮。', block: '真實故事／好齡居誌' },
  { num: '04', name: '引導行動', desc: '先說明合作如何進行，再提供容易開始的聯絡方式。', block: '顧問諮詢流程／聯絡表單' },
];

/** 現行首頁長頁截圖上的區塊標記（百分比依 2026-08-26 擷取時的各區塊位置） */
const MARKERS = [
  { num: '01', top: 0, height: 8.3 },
  { num: '02', top: 8.3, height: 35.4 },
  { num: '04', top: 43.7, height: 9 },
  { num: '03', top: 52.7, height: 29.8 },
  { num: '04', top: 84.2, height: 8.7 },
];

const PRINCIPLES = [
  '談效益，而非服務規格',
  '提供專業建議',
  '用日常關心拉近距離',
  '避免失能化語言',
  '建立夥伴關係',
  '服務完善，也保留選擇',
  '看見小投入帶來的改善',
];

const AI_FLOW = ['研究定義原則', 'AI 輔助檢查', '人員確認與修改'];

const LIVE_SHOTS = [
  {
    src: '/images/work/nexdo/nexdo-home-hero-20260826.jpg',
    alt: '好齡居現行網站首頁，以「從整理開始，人生每個轉折，都有好齡居守護您的安心日常」與家庭情境開場',
    caption: '品牌先從生活轉折與陪伴建立關聯。',
    width: 2880,
    height: 1800,
  },
  {
    src: '/images/work/nexdo/nexdo-home-services-20260826.jpg',
    alt: '好齡居現行首頁的服務入口卡片，以居住安全、收納清潔、租房搬家等生活情境介紹服務',
    caption: '服務入口由內部名稱改為使用者能辨識的生活情境。',
    width: 1600,
    height: 2090,
  },
  {
    src: '/images/work/nexdo/nexdo-home-steps-20260826.jpg',
    alt: '好齡居現行首頁以填表預約、真人顧問、透明溝通、安心出發四個步驟說明合作流程',
    caption: '使用者在聯絡前就能預期合作如何進行。',
    width: 2880,
    height: 1534,
  },
  {
    src: '/images/work/nexdo/nexdo-about-hero-20260826.jpg',
    alt: '好齡居現行網站關於頁，以「因為懂，所以想陪你一起」與跨世代家庭情境說明品牌角色',
    caption: '品牌以理解與陪伴說明自己如何進入家庭。',
    width: 2880,
    height: 1800,
  },
];

const CHANGES = [
  { num: '01', name: '受眾', desc: '從籠統的樂齡客群，釐清為購買服務的子女與接受服務的長輩兩種角色。' },
  { num: '02', name: '服務', desc: '從依內部分工分類，改為從居住安全、整理、健康與搬遷等生活問題開始。' },
  { num: '03', name: '品牌', desc: '從多元服務供應者，重新定位為兼顧專業判斷與家庭溝通的第三方。' },
  { num: '04', name: '網站與內容', desc: '從一次性的頁面與文案，建立可持續使用的首頁架構、內容原則與 AI 輔助流程。' },
];
---

<BaseLayout
  title="好齡居品牌與網站優化：從受眾研究到服務定位｜致遠專案實例"
  description="致遠如何透過受眾研究，協助好齡居釐清子女與長輩的需求差異，重整服務分類、品牌角色、網站架構與內容原則。"
  isHome
  ogTitle="好齡居｜重新定義長照服務的角色與價值"
  ogDescription="從研究不同世代的真實需求，到建立可持續使用的品牌、服務與網站策略。"
  ogImage="/images/work/nexdo/nexdo-og-20260826.jpg"
>
  {/* ---- Hero｜直接說明致遠做了什麼 ---- */}
  <section class="bg-page">
    <div class="container-site pb-14 pt-16 md:pb-20 md:pt-24">
      <p class="wc-label" data-reveal>好齡居 NEXDO｜品牌研究・服務定位・網站策略</p>
      <h1 class="wc-h1" data-reveal>從跨世代需求研究，重新整理好齡居的品牌、服務與網站</h1>
      <p class="mt-6 max-w-3xl text-lg leading-loose text-ink-secondary" data-reveal>
        當購買服務的是子女、真正接受服務的是長輩，品牌不能只對其中一方說話。我們協助好齡居看清雙方需求，找出適合進入家庭的角色，並把研究判斷轉化為可執行的網站與內容方向。
      </p>
      <ul class="mt-8 flex flex-wrap gap-2" data-reveal>
        {INFO.map((item) => <li class="wc-pill">{item}</li>)}
      </ul>

      {/* 網站 Before／After（依 目錄-19 分別裁出舊／新網站畫面重製；手機上下排列） */}
      <figure class="mt-12" data-reveal>
        <div class="wc-ba">
          <div class="wc-ba-col">
            <p class="wc-ba-tag wc-ba-tag-before">
              <span>Before</span>
              依內部分工介紹服務
            </p>
            <div class="wc-ba-frame">
              <img
                src="/images/work/nexdo/nexdo-site-before.jpg"
                alt="好齡居改版前的網站，以「精緻專業的樂齡居家整合服務」與熱門精選、房屋住宅等服務清單開場"
                width="1140"
                height="1380"
                class="wc-ba-img"
              />
            </div>
          </div>
          <div class="wc-ba-col">
            <p class="wc-ba-tag wc-ba-tag-after">
              <span>After</span>
              從家庭的生活需求開始
            </p>
            <div class="wc-ba-frame wc-ba-frame-after">
              <img
                src="/images/work/nexdo/nexdo-site-after.jpg"
                alt="好齡居改版後的網站，以「從家庭環境到銀髮健康」帶出居住安全、清潔收納等生活情境入口"
                width="1120"
                height="1380"
                class="wc-ba-img"
              />
            </div>
          </div>
        </div>
        <figcaption class="mt-3 text-sm text-ink-muted">研究不只改變了畫面，也重新決定網站要先回答誰的問題。</figcaption>
      </figure>
    </div>
  </section>

  {/* ---- Our Approach｜先讓訪客知道專案做了哪些事 ---- */}
  <section class="border-t border-line bg-page">
    <div class="container-site py-16 md:py-24">
      <p class="wc-label" data-reveal>Our Approach｜我們的方式</p>
      <h2 class="wc-h2" data-reveal>從理解人，到重新安排品牌如何被看見</h2>
      <div class="wc-prose" data-reveal>
        <p>
          本案不是先決定網站要畫成什麼樣子，而是依序釐清四件事：誰在找服務、雙方為何難以達成共識、品牌應該扮演什麼角色，以及這些判斷如何落實到網站與日常內容。
        </p>
      </div>
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {
          APPROACH.map((a) => (
            <li class="wc-approach">
              <p class="text-sm font-bold text-brand">{a.num}</p>
              <h3 class="mt-2 text-lg font-bold text-ink">{a.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-secondary">{a.desc}</p>
              <a href={a.href} class="wc-anchor-link">
                {a.link}
                <span aria-hidden="true">↓</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---- Challenge｜服務很多，使用者卻不知道該從哪裡開始 ---- */}
  <section class="border-t border-line bg-page">
    <div class="container-site py-16 md:py-24">
      <p class="wc-label" data-reveal>The Challenge</p>
      <h2 class="wc-h2" data-reveal>好齡居需要解決的，不只是網站怎麼分類服務</h2>
      <div class="wc-prose" data-reveal>
        <p>
          好齡居涵蓋居住安全、整理收納、健康支持與搬遷等服務。原有網站依照內部分工介紹項目，雖然完整，卻要求使用者先理解公司的專業分類，才能判斷哪一項與自己有關。
        </p>
        <p>
          更深一層的問題是：主動搜尋與購買服務的通常是子女，真正要接受改變的卻是長輩。子女關心安全與風險，長輩在意自主、尊嚴，以及自己是否仍能參與決定。品牌若只強調「為長者改善」，可能在進入家庭前就被拒絕。
        </p>
      </div>

      {/* 子女在意／長輩在意（依 目錄-68 重製，去除可辨識資訊） */}
      <figure class="mt-12" data-reveal>
        <div class="wc-gap">
          <div class="wc-gap-card">
            <p class="text-sm font-bold text-brand">子女在意</p>
            <ul class="wc-gap-list">
              <li>安全</li>
              <li>風險</li>
              <li>是否有人協助處理</li>
            </ul>
          </div>
          <p class="wc-gap-center">同一份關心，<br class="hidden md:inline" />可能形成不同的理解。</p>
          <div class="wc-gap-card">
            <p class="text-sm font-bold text-brand">長輩在意</p>
            <ul class="wc-gap-list">
              <li>自主</li>
              <li>尊嚴</li>
              <li>是否仍有選擇</li>
            </ul>
          </div>
        </div>
      </figure>

      <p class="wc-key" data-reveal>
        <span class="wc-key-label">關鍵問題</span>
        好齡居要如何讓子女看見專業，也讓長輩感受到自己不是被安排？
      </p>
    </div>
  </section>

  {/* ---- 研究發現｜先分清楚找服務的人與接受服務的人 ---- */}
  <section id="research" class="border-t border-line bg-page">
    <div class="container-site py-16 md:py-24">
      <p class="wc-method" data-reveal><span>受眾研究</span>問卷研究＋深度訪談</p>
      <h2 class="wc-h2" data-reveal>我們先找出決策關係，再決定品牌要對誰說話</h2>
      <div class="wc-prose" data-reveal>
        <p>
          我們以問卷掌握不同年齡、居住狀況與購買情境的需求，再透過深度訪談理解需求背後的家庭關係。研究顯示，服務購買者與使用者經常不是同一個人：子女負責搜尋與評估，長輩則決定改變能否真正進入生活。
        </p>
        <p>
          這讓專案方向從「列出更多服務」轉為「同時建立兩種理解」：讓子女快速判斷服務是否專業可靠，也避免用失能與被照顧的語言定義長輩。
        </p>
      </div>

      {/* 研究流程三步驟（依 目錄-14、目錄-16 重製；研究規模數字預設不顯示） */}
      <figure class="mt-12" data-reveal>
        <ol class="wc-flow">
          {
            RESEARCH_FLOW.map((step, i) => (
              <li class="wc-flow-step">
                <span class="wc-step-num">{i + 1}</span>
                <span class="font-semibold text-ink">{step}</span>
                {i < RESEARCH_FLOW.length - 1 && <span class="wc-flow-arrow" aria-hidden="true">→</span>}
              </li>
            ))
          }
        </ol>
      </figure>

      {/* 購買者／使用者角色差異（依 目錄-54 重製，不用 Persona 人臉） */}
      <figure class="mt-8 grid gap-4 md:grid-cols-2" data-reveal>
        <div class="wc-role">
          <p class="text-sm font-bold uppercase tracking-wide text-ink-muted">購買服務的人</p>
          <p class="mt-2 text-xl font-bold text-ink">子女</p>
          <p class="mt-2 leading-relaxed text-ink-secondary">負責搜尋、比較與評估，關心服務是否專業可靠，以及做了之後能不能更放心。</p>
        </div>
        <div class="wc-role">
          <p class="text-sm font-bold uppercase tracking-wide text-ink-muted">接受服務的人</p>
          <p class="mt-2 text-xl font-bold text-ink">長輩</p>
          <p class="mt-2 leading-relaxed text-ink-secondary">決定改變能否真正進入生活，在意自主與尊嚴，也在意自己是否仍被當成做決定的人。</p>
        </div>
      </figure>
      <p class="mt-3 text-sm text-ink-muted" data-reveal>研究先確認找服務的人與接受服務的人並不相同，再決定品牌與網站要同時回應誰。</p>

      <p class="wc-key" data-reveal>
        <span class="wc-key-label">關鍵判斷</span>
        網站面對的不是單一客群，而是一段需要被協調的家庭決策。
      </p>
    </div>
  </section>

  {/* ---- 策略一｜用生活問題重整服務架構 ---- */}
  <section id="architecture" class="border-t border-line bg-page">
    <div class="container-site py-16 md:py-24">
      <p class="wc-method" data-reveal><span>策略一</span>資訊架構重整</p>
      <h2 class="wc-h2" data-reveal>從「公司提供什麼」，改成「使用者現在遇到什麼」</h2>

      <div class="wc-decision" data-reveal>
        <div class="wc-dec wc-dec-before">
          <p class="wc-dec-label">Before</p>
          <p>原有分類以居家照護、適老換屋、居家改造、關懷陪伴等專業服務為主，反映公司如何執行，卻不一定符合使用者描述問題的方式。</p>
        </div>
        <div class="wc-dec wc-dec-judge">
          <p class="wc-dec-label">我們如何判斷</p>
          <p>研究發現，使用者多半從生活情境開始思考：家中是否安全、物品是否難以整理、是否需要搬家，以及如何維持健康生活。</p>
        </div>
        <div class="wc-dec wc-dec-after">
          <p class="wc-dec-label">After</p>
          <p>我們協助好齡居將主要入口重整為居住安全、清潔收納、租房搬家與樂齡健康，讓使用者先找到與自己有關的問題，再理解相應服務；軟裝設計則保留為獨立服務。</p>
        </div>
      </div>

      {/* 分類 Before／After（依 目錄-17、目錄-44 重製；箭頭表示分類邏輯改變，非一對一更名） */}
      <figure class="mt-12" data-reveal>
        <div class="wc-cat">
          <div class="wc-cat-panel">
            <p class="text-sm font-bold text-ink-muted">依內部分工分類</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {OLD_CATEGORIES.map((c) => <li class="wc-chip">{c}</li>)}
            </ul>
          </div>
          <div class="wc-cat-arrow" aria-hidden="true">→</div>
          <div class="wc-cat-panel wc-cat-panel-after">
            <p class="text-sm font-bold text-brand">依生活問題分類</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {NEW_CATEGORIES.map((c) => <li class="wc-chip wc-chip-brand">{c}</li>)}
              <li class="wc-chip wc-chip-outline">軟裝設計（獨立服務）</li>
            </ul>
          </div>
        </div>
        <figcaption class="mt-3 text-sm text-ink-muted">服務沒有變少，使用者理解服務的起點改變了。</figcaption>
      </figure>
    </div>
  </section>

  {/* ---- 策略二｜重新界定品牌進入家庭的角色 ---- */}
  <section id="brand" class="border-t border-line bg-page">
    <div class="container-site py-16 md:py-24">
      <p class="wc-method" data-reveal><span>策略二</span>品牌定位</p>
      <h2 class="wc-h2" data-reveal>品牌不替任何一方做決定，而是讓雙方更容易開始討論</h2>

      <div class="wc-decision" data-reveal>
        <div class="wc-dec wc-dec-before">
          <p class="wc-dec-label">Before</p>
          <p>品牌若只站在子女一側強調風險與改善，容易讓長輩感到自己被當成需要處理的問題；但若只維持現況，也無法回應子女對安全的擔心。</p>
        </div>
        <div class="wc-dec wc-dec-judge">
          <p class="wc-dec-label">我們如何判斷</p>
          <p>訪談讓我們看見，真正阻礙服務的往往不是沒有需求，而是雙方對「為什麼要改」沒有共同理解。好齡居需要兼顧專業判斷與平等溝通。</p>
        </div>
        <div class="wc-dec wc-dec-after">
          <p class="wc-dec-label">After</p>
