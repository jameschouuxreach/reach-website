---
/**
 * 專案類型摘要卡（探索型／優化型各三張）：整張卡為單一 <a>，內部 CTA 為 <span>。
 * 內容順序：專案類型標題 → 副標 → 小標「適合誰」→ fit 內文 → 查看專案說明。
 * headingLevel 依頁面結構傳入（ProjectTypeGroups 內的群組標題為 H3，卡片標題用 H4，避免跳級）。
 */
import type { ProjectType } from '../../data/services';
import { getProjectTypePath } from '../../data/services';

interface Props extends ProjectType {
  headingLevel?: 'h3' | 'h4';
}

const { slug, title, subtitle, fit, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const href = getProjectTypePath(slug);
---

<a href={href} class="svc-link-card card flex h-full flex-col p-6 no-underline md:p-8">
  <Heading class="svc-card-title text-[1.375rem] font-bold text-ink md:text-2xl">{title}</Heading>
  <p class="mt-3 text-[17px] font-semibold leading-relaxed text-ink md:text-lg">{subtitle}</p>
  <p class="mt-5 text-sm font-bold text-brand">適合誰</p>
  <p class="mt-1.5 leading-relaxed text-ink-secondary">{fit}</p>
  <p class="mt-auto pt-7">
    <span class="svc-card-cta inline-flex items-center gap-1.5 font-semibold text-ink-secondary">
      查看專案說明
      <span class="cta-arrow" aria-hidden="true">→</span>
    </span>
  </p>
</a>

<style>
  .svc-link-card {
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      transform 120ms ease;
  }

  .svc-link-card:hover,
  .svc-link-card:focus-visible {
    background-color: var(--reach-blue-50);
    border-color: var(--color-brand);
  }

  .svc-link-card:active {
    transform: translateY(1px);
  }

  .svc-link-card:focus-visible {
    outline: 2px solid var(--reach-blue-300);
    outline-offset: 3px;
  }

  .svc-card-title,
  .svc-card-cta {
    transition: color 200ms ease;
  }

  .svc-link-card:hover .svc-card-title,
  .svc-link-card:focus-visible .svc-card-title,
  .svc-link-card:hover .svc-card-cta,
  .svc-link-card:focus-visible .svc-card-cta {
    color: var(--color-brand);
  }

  .svc-card-cta .cta-arrow {
    transition: transform 200ms ease;
  }

  .svc-link-card:hover .cta-arrow,
  .svc-link-card:focus-visible .cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-link-card,
    .svc-card-title,
    .svc-card-cta,
    .svc-card-cta .cta-arrow {
      transition: none;
    }

    .svc-link-card:active,
    .svc-link-card:hover .cta-arrow,
    .svc-link-card:focus-visible .cta-arrow {
      transform: none;
    }
  }
</style>
