                width="1024"
                height="559"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="ne-dodont-text">
              <div class="ne-dodont-item ne-dodont-do">
                <p class="ne-dodont-label">Do｜要專業</p>
                <p class="ne-dodont-copy">把浴室<mark>門檻降低、加上防滑緩坡</mark>，進出更加輕鬆。</p>
              </div>
              <div class="ne-dodont-item ne-dodont-dont">
                <p class="ne-dodont-label">Don’t｜不抽象</p>
                <p class="ne-dodont-copy">針對浴室的門檻，我們有更輕鬆的進出方案。</p>
              </div>
            </div>
          </div>
          <figcaption class="ne-caption">正反範例將抽象原則轉成可比較的文字，讓撰稿者知道如何判斷與修改。</figcaption>
        </figure>

        <h3 class="ne-h3">讓後續內容，都有共同的判斷依據</h3>
        <p class="ne-p">
          從新增服務頁到撰寫文章，團隊都能回到同一套指南，檢查內容是否符合品牌特質、是否說清楚對讀者的幫助。這份交付讓品牌定位能持續用在日常內容工作中。
        </p>
        {/* E11：p.77 重繪，映射沿原頁 */}
        <figure class="ne-fig">
          <ul class="ne-guides">
            {
              PRINCIPLE_MAP.map((row) => (
                <li class="ne-panel ne-guide">
                  <p class="ne-guide-trait">{row.trait}</p>
