---
/**
 * 相關案例「整理中」狀態：非互動卡，內容只有正式候選名稱與「案例內容整理中」。
 * 不顯示假圖片、假摘要、假成果或箭頭；不使用 href="#" 或假網址。
 * 不為此改動 CaseCard 的視覺或資料界面。
 */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<article class="card flex h-full flex-col justify-center p-7 md:p-8">
  <h3 class="text-xl font-bold text-ink-secondary md:text-2xl">{name}</h3>
  <p class="mt-3 flex items-center gap-2 text-sm font-medium text-ink-muted">
    <span class="inline-block h-2 w-2 rounded-full bg-line-strong" aria-hidden="true"></span>
    案例內容整理中
  </p>
</article>
