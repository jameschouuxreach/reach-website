---
/**
 * 好齡居專案實例｜版本 D（第四版，2026-09-11）。
 * 文案、圖片位置、圖說與版面規則依《好齡居專案實例-版本D-第四版文案與開發規格.md》第 2～4 節；
 * 素材來源註（結案簡報頁碼）只留在此註解與該文件，不上稿。
 *
 * 結構：開場（H1＋背景＋資訊列＋F01）→ 三項挑戰 → 五張跳轉卡（#approach）
 *       → 閱讀區（桌面左側常駐目錄／窄螢幕頂部折疊目錄＋五段內容）→ 收尾 CTA。
 * 五段 ID：research／brand／architecture／interface／content；卡片、目錄與段落共用同一組 hash，
 * 卡片主張與段落 H2 由同一份 PARTS 常數輸出，保證逐字相同。
 *
 * 圖片來源（結案簡報 PDF，頁碼從封面算第 1 頁）：
 *   F01 p.70 左側設計總覽（手機版為同源首屏裁切：Logo＋第一個畫面；OG 圖為 F01 上緣 1200×630 縮圖）
 *   F02 p.13 右上受眾輪廓　F03 p.17 雙方需求對照　F04 p.28 五大特質　F05 p.50 服務定位圖
 *   F06 p.37 分類重整　F07a／F07b p.64 左右畫面　F08 p.55 首頁四階段　F09 p.77　F10 p.80　F11 p.81
 * 簡報中的新版網站為設計提案／原型畫面，一律標「改版設計示意」；圖中灰色佔位為原型證據，不補造內容。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const IMG = '/images/work/nexdo/v4';

/** 五項成果：卡片、目錄、段落標題共用（順序即閱讀順序） */
const PARTS = [
  { id: 'research', num: '01', name: '研究分析', claim: '結合質性與量化，清楚了解受眾全貌' },
  { id: 'brand', num: '02', name: '品牌定位', claim: '定位品牌特質與服務價值，讓受眾認識好齡居的專業' },
  { id: 'architecture', num: '03', name: '資訊架構設計', claim: '重整網站內容分類及名稱，讓使用者更容易找到服務' },
  { id: 'interface', num: '04', name: '介面與原型設計', claim: '重新規劃首頁內容佈局，讓網站更加吸引人' },
  { id: 'content', num: '05', name: '內容策略', claim: '定義品牌專屬的文案原則，讓品牌能輕鬆維持一致形象' },
] as const;

const [RESEARCH, BRAND, ARCHITECTURE, INTERFACE, CONTENT] = PARTS;

const CHALLENGES = [
  {
    title: '不清楚誰會購買、為什麼購買，品牌難以對準溝通對象',
    body: '有需要的是長輩，主動尋找服務的卻可能是子女；品牌需要同時理解付款者的考量與使用者的顧慮。',
  },
  {
    title: '服務眾多且抽象，客戶難以判斷自己需要哪一項',
    body: '當相近服務分散在不同類別，名稱又無法直接說明用途，使用者就得先研究整張清單，才能找到適合的協助。',
  },
  {
    title: '服務重點不明確，難以和一般居家清潔形成區隔',
    body: '好齡居涵蓋居住安全與健康等多項服務，卻還需要一個清楚的主打方向，讓人理解這些專業如何共同回應家庭需求。',
  },
];

/** F02 手機重排 */
const AUDIENCE_PROFILE = [
  '25～54 歲',
  '與家人同住、想買服務給長輩',
  '重視長輩安全，對評估診斷及空間改善有興趣',
  '有預算限制',
];

/** F03 手機重排（研究歸納，不用引號） */
const FAMILY_NEEDS = [
  { role: '子女', items: ['希望付出與照顧被看見', '希望長輩平安健康'] },
  { role: '長輩', items: ['希望被當作有自主權的人', '不想成為家人的負擔'] },
];

/** F04 手機重排 */
const BRAND_TRAITS = [
  { layer: '執行層面', traits: [['專業', '專業有保障'], ['完善', '全面完善']] },
  { layer: '溝通層面', traits: [['溫暖', '溫暖舒適'], ['彈性', '彈性不強迫'], ['共創', '平等共創']] },
];

/** F06 手機重排：改版前／後完整細項 */
const CATEGORIES_BEFORE = [
  { name: '居家照護', items: ['居家整聊', '安全評估', '衛浴裝修', '安心移居'] },
  { name: '適老換屋', items: ['適老換屋', '舊屋診斷', '代租代管', '房屋仲介'] },
  { name: '居家改造', items: ['軟裝設計', '室內清運', '收納規劃'] },
  { name: '關懷陪伴', items: ['牙科衛教', '營養諮詢', '體適能'] },
];
const CATEGORIES_AFTER = [
  { name: '居家安全', items: ['舊屋診斷', '安全評估', '衛浴裝修'] },
  { name: '收納清潔', items: ['室內清運', '收納規劃', '居家整聊'] },
  { name: '租房搬家', items: ['適老換屋', '安心移居', '代租代管', '房屋仲介'] },
  { name: '樂齡健康', items: ['牙科衛教', '營養諮詢', '體適能'] },
  { name: '獨立服務 軟裝設計', items: ['軟裝設計'] },
];

/** 首頁四個溝通階段（F08 旁說明） */
const STAGES = [
  { num: '01', name: '建立印象', body: '用品牌主張說明服務對象與核心價值，讓訪客先知道好齡居能幫什麼。', blocks: '首屏主視覺' },
  { num: '02', name: '了解服務', body: '從居家安全等生活需求帶出服務，再補充細項與其他選擇。', blocks: '服務價值主張、三項主題、熱門服務、延伸服務' },
  { num: '03', name: '取得信任', body: '安排服務案例與贊助企業資訊，提供判斷品牌可信度的依據。', blocks: '服務案例、贊助企業' },
  { num: '04', name: '引導行動', body: '先交代合作流程，再提供諮詢入口，讓訪客知道聯絡後會怎麼進行。', blocks: '服務流程、諮詢' },
];

/** F09 手機重排：品牌特質 → 指南 */
const PRINCIPLE_MAP = [
  { trait: '專業有保障／講效益', guides: ['談效益而非服務規格', '專業建議'] },
  { trait: '溫暖舒適／講暖話', guides: ['日常關心'] },
  { trait: '平等共創／講我們', guides: ['去失能化', '夥伴關係'] },
  { trait: '全面完善／講貼心', guides: ['服務完善可自由選擇'] },
  { trait: '彈性不強迫／講隨緣', guides: ['小投入大改善'] },
];

const DESCRIPTION =
  '致遠透過受眾研究，協助好齡居確立品牌定位、重整服務分類與首頁設計，並建立可沿用的文案指南。';
---

<BaseLayout
  title="好齡居品牌定位、服務分類與網站設計｜致遠專案實例"
  description={DESCRIPTION}
  isHome
  ogTitle="好齡居｜受眾研究、品牌定位與網站改版"
  ogDescription={DESCRIPTION}
  ogImage={`${IMG}/nexdo-v4-og.jpg`}
>
  <article class="nd">
    {/* ---- 開場：藍色小字＋H1＋背景＋資訊列＋F01 ---- */}
    <section class="bg-page">
      <div class="container-site pb-14 pt-16 md:pb-20 md:pt-24">
        <p class="nd-eyebrow">好齡居 NEXDO｜銀髮生活服務</p>
        <h1 class="nd-h1">好齡居｜以受眾研究重整品牌定位、服務分類與網站設計</h1>
        <p class="nd-lead">
          好齡居以提供全面的長照生活服務為目標，為銀髮族及其家庭整合居家安全、整理清潔、健康支持與搬遷等協助。這類服務往往需要子女與長輩共同做決定，既有的服務分類與說明，卻讓人難以判斷自己需要什麼、為何值得投入。致遠透過研究釐清受眾與需求，確立品牌定位，並將成果轉化為服務分類、網站改版設計與文案指南，讓品牌更清楚地說明能提供的協助。
        </p>

        <dl class="nd-meta">
          <div class="nd-meta-item">
            <dt>客戶</dt>
            <dd>好齡居 NEXDO</dd>
          </div>
          <div class="nd-meta-item">
            <dt>專案範圍</dt>
            <dd>研究分析／品牌定位／資訊架構設計／介面與原型設計／內容策略</dd>
          </div>
          <div class="nd-meta-item">
            <dt>研究規模</dt>
            <dd>303 份問卷、5 位深度訪談</dd>
          </div>
        </dl>

        <figure class="nd-fig nd-fig-hero">
          <p class="nd-fig-tag">改版設計示意</p>
          <div class="nd-fig-media">
            <picture>
              {/* 手機：同源首屏裁切，避免長圖推遲挑戰與五卡 */}
              <source media="(max-width: 767px)" srcset={`${IMG}/f01-design-overview-mobile.webp`} width="923" height="1286" />
              <img
                src={`${IMG}/f01-design-overview.webp`}
                alt="好齡居首頁改版設計示意，呈現生活需求入口、服務介紹與諮詢流程"
                width="2400"
                height="1827"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
          <figcaption>我們把受眾研究轉成看得見的網站設計：先說明能解決的生活問題，再安排服務介紹與諮詢入口。</figcaption>
        </figure>
      </div>
    </section>

    {/* ---- 本案遇到哪些挑戰？ ---- */}
    <section class="border-t border-line bg-page">
      <div class="container-site py-16 md:py-24">
        <h2 class="nd-h2" data-reveal>本案遇到哪些挑戰？</h2>
        <ol class="nd-challenges" data-reveal>
          {
            CHALLENGES.map((item, i) => (
              <li class="nd-challenge">
                <span class="nd-challenge-num" aria-hidden="true">{`0${i + 1}`}</span>
                <h3 class="nd-challenge-title">{item.title}</h3>
                <p class="nd-challenge-body">{item.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ---- 我們做了什麼？五張跳轉卡（無補充文案，CTA 一律「查看更多」） ---- */}
    <section id="approach" class="border-t border-line bg-page">
      <div class="container-site py-16 md:py-24">
        <h2 class="nd-h2" data-reveal>我們做了什麼？</h2>
        <p class="nd-p" data-reveal>
          我們把研究結果轉成五項可執行的成果，協助好齡居決定對誰說、主打什麼，以及網站和文案該怎麼呈現。點選卡片，可直接查看對應的做法與設計實例。
        </p>
        <ol class="nd-cards" data-reveal>
          {
            PARTS.map((part) => (
              <li>
                <a href={`#${part.id}`} class="nd-card" data-nd-jump>
                  <span class="nd-card-num">{`${part.num} ${part.name}`}</span>
                  <span class="nd-card-claim">{part.claim}</span>
                  <span class="nd-card-cta">
                    查看更多
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ---- 閱讀區：目錄（桌面左側常駐／窄螢幕頂部折疊）＋五段內容 ---- */}
    <div class="nd-read border-t border-line bg-page" data-nd-read>
      {/* 窄螢幕折疊目錄：原生 details，無 JS 時仍可展開與跳轉；收合文字由 JS 補上目前段落 */}
      <details class="nd-toc-m" data-nd-toc-mobile>
        <summary class="nd-toc-m-summary">
          <span class="container-site nd-toc-m-summary-inner">
            <span class="nd-toc-m-label">本頁目錄<span data-nd-toc-current hidden></span></span>
            <svg class="nd-toc-m-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </summary>
        <nav aria-label="本頁目錄" class="nd-toc-m-list">
          <ol class="container-site" data-nd-toc>
            {
              PARTS.map((part) => (
                <li>
                  <a href={`#${part.id}`} class="nd-toc-link" data-nd-jump>{part.name}</a>
                </li>
              ))
            }
          </ol>
        </nav>
      </details>

      <div class="container-site nd-read-grid">
        {/* 桌面左側常駐目錄（≥1024px）；與窄螢幕目錄不會同時顯示 */}
        <nav aria-label="本頁目錄" class="nd-toc-d">
          <ol data-nd-toc>
            {
              PARTS.map((part) => (
                <li>
                  <a href={`#${part.id}`} class="nd-toc-link" data-nd-jump>{part.name}</a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="nd-read-body">
          {/* ---- 01 研究分析 ---- */}
          <section id={RESEARCH.id} class="nd-part" data-nd-part data-nd-name={RESEARCH.name}>
            <p class="nd-kicker">{`${RESEARCH.num} ${RESEARCH.name}`}</p>
            <h2 class="nd-h2" tabindex="-1" data-nd-heading>{RESEARCH.claim}</h2>
            <p class="nd-p">我們用問卷找出需求較明確的族群，再透過訪談理解他們為何猶豫。兩種研究相互補充，讓品牌定位與網站設計有共同依據。</p>

            <div class="nd-split">
              <div>
                <h3 class="nd-h3">透過問卷數據分析，精準描繪受眾樣貌</h3>
                <p class="nd-p">
                  我們分析 303 份問卷，比較居住狀況、購買對象與服務需求，將主要溝通對象聚焦在與長輩同住、希望替長輩購買服務的成年子女。這群人重視安全，也有預算考量，因此後續設計優先回應居家風險與可負擔的改善需求。
                </p>
              </div>
              <figure class="nd-fig nd-fig-swap">
                <p class="nd-fig-tag">研究洞察整理</p>
                <div class="nd-fig-media">
                  <img
                    src={`${IMG}/f02-audience-profile.webp`}
                    alt="問卷研究收斂的受眾輪廓，包括與長輩同住、為長輩購買服務、重視安全與預算限制"
                    width="2105"
                    height="962"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="nd-fig-alt">
                  <div class="nd-alt">
                    <p class="nd-alt-title">本案研究收斂的受眾輪廓</p>
                    <ul class="nd-alt-list">
                      {AUDIENCE_PROFILE.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                  <a href={`${IMG}/f02-audience-profile.webp`} class="nd-fig-open" target="_blank" rel="noopener noreferrer" aria-label="查看原圖：問卷分析收斂出的受眾輪廓">
                    查看原圖
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
                <figcaption>問卷分析讓品牌知道應優先回應哪一群人的需求，並把安全與預算納入服務溝通重點。</figcaption>
              </figure>
            </div>

            <h3 class="nd-h3">透過訪談，深入了解受眾需求及痛點</h3>
            <p class="nd-p">
              5 位深度訪談讓我們看見：子女擔心安全、希望照顧被理解，長輩則在意自己是否還能決定生活。服務能否被接受，還取決於如何討論改變，因此我們把尊重選擇與平等溝通納入品牌及文案方向。
            </p>
            <figure class="nd-fig nd-fig-swap">
              <p class="nd-fig-tag">研究洞察整理</p>
              <div class="nd-fig-media">
                <img
                  src={`${IMG}/f03-family-needs.webp`}
                  alt="研究整理的子女與長輩需求對照：子女希望照顧被看見，長輩希望自主受到尊重"
                  width="2400"
                  height="939"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="nd-fig-alt">
                <div class="nd-alt nd-alt-pair">
                  {
                    FAMILY_NEEDS.map((side) => (
                      <div>
                        <p class="nd-alt-title">
                          <span class="nd-alt-role">{side.role}</span>研究歸納
                        </p>
                        <ul class="nd-alt-list">
                          {side.items.map((item) => <li>{item}</li>)}
                        </ul>
                      </div>
                    ))
                  }
                </div>
                <a href={`${IMG}/f03-family-needs.webp`} class="nd-fig-open" target="_blank" rel="noopener noreferrer" aria-label="查看原圖：子女與長輩的顧慮對照">
                  查看原圖
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
              <figcaption>同一項居家改善，需要回應子女的安心與長輩的自主；這項發現影響了品牌語氣與服務說明。</figcaption>
            </figure>
          </section>

          {/* ---- 02 品牌定位 ---- */}
          <section id={BRAND.id} class="nd-part" data-nd-part data-nd-name={BRAND.name}>
            <p class="nd-kicker">{`${BRAND.num} ${BRAND.name}`}</p>
            <h2 class="nd-h2" tabindex="-1" data-nd-heading>{BRAND.claim}</h2>
            <p class="nd-p">我們協助好齡居確立服務主打方向，並定義品牌與家庭互動的方式，讓後續網站與文案有清楚的判斷標準。</p>

            <h3 class="nd-h3">定位品牌五大特質，建立專業又有溫度的品牌印象</h3>
            <p class="nd-p">
              依據受訪者對服務的期待，我們整理出專業、完善、溫暖、彈性與共創五項特質。前兩項回應服務品質與完整性的期待，後三項則要求品牌在溝通時保留選擇、聆聽雙方，避免讓長輩感到被安排。
            </p>
            <figure class="nd-fig nd-fig-swap">
              <p class="nd-fig-tag">品牌定位準則</p>
              <div class="nd-fig-media">
                <img
                  src={`${IMG}/f04-brand-traits.webp`}
                  alt="好齡居五大品牌特質，分為執行層面的專業、完善，以及溝通層面的溫暖、彈性、共創"
                  width="2400"
                  height="838"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="nd-fig-alt">
                <div class="nd-alt nd-alt-pair">
                  {
                    BRAND_TRAITS.map((layer) => (
                      <div>
                        <p class="nd-alt-title">{layer.layer}</p>
                        <ul class="nd-alt-list">
                          {layer.traits.map(([trait, note]) => (
                            <li>
                              <strong>{trait}</strong>—{note}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))
                  }
                </div>
                <a href={`${IMG}/f04-brand-traits.webp`} class="nd-fig-open" target="_blank" rel="noopener noreferrer" aria-label="查看原圖：五大品牌特質">
