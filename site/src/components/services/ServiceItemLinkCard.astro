---
/**
 * 專案頁「此專案通常會有哪些執行項目？」的服務項目卡（2026-09-01 業主指示：由 pill 改為卡片）。
 * - 2026-09-08 業主指示改為非互動卡：不再連至服務類別頁、無 hover 狀態、無箭頭（原為整卡 <a> 連到 /services/{category}/#{item}）。
 *   ResolvedServiceItem 的 href 仍由資料層提供，此處不使用；要恢復連結時把根節點換回 <a href={href}> 即可。
 * - 上方為所屬服務類別標籤（四類四色）、項目名稱（H3）、與服務類別頁相同的說明內文。
 * - 標籤色為業主要求「四類用不同顏色區隔」而加入的低飽和色，僅用於此標籤；文字對比皆 ≥ 4.5:1。
 */
import type { ResolvedServiceItem } from '../../data/services';

type Props = ResolvedServiceItem;

const { category, item } = Astro.props;
---

<div class="svc-item-card card flex h-full w-full flex-col p-5 md:p-6" data-category={category.slug}>
  <p class="svc-item-tag">{category.title}</p>
  <h3 class="mt-3 text-lg font-bold text-ink md:text-xl">{item.title}</h3>
  <p class="mt-2 text-[15px] leading-relaxed text-ink-secondary md:text-base">{item.description}</p>
</div>

<style>
  /* ---- 服務類別標籤：四類四色（淡底＋深字） ---- */
  .svc-item-tag {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 1.5rem;
    padding-inline: 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .svc-item-card[data-category='research'] .svc-item-tag {
    background-color: var(--reach-blue-100);
    color: var(--reach-blue-700);
  }

  .svc-item-card[data-category='experience-design'] .svc-item-tag {
    background-color: #ddf4f0; /* 青綠 */
    color: #0f6e63;
  }

  .svc-item-card[data-category='brand-service-strategy'] .svc-item-tag {
    background-color: #ece8fd; /* 紫 */
    color: #5a32b4;
  }

  .svc-item-card[data-category='experience-consulting'] .svc-item-tag {
    background-color: #fdeedc; /* 暖橘 */
    color: #9a4b12;
  }
</style>
