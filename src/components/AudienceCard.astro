---
/**
 * 客群分流卡：整張卡可點擊，卡內保留可辨認的文字 CTA。
 * 兩張卡預設與 hover／focus 樣式完全相同（規格 §5.4），不以視覺暗示主次。
 */
interface Props {
  pill: string;
  title: string;
  body: string;
  href: string;
  ariaLabel: string;
}

const { pill, title, body, href, ariaLabel } = Astro.props;
---

<a href={href} aria-label={ariaLabel} class="audience-card card group flex h-full flex-col p-7 no-underline md:p-9">
  <p>
    <span class="inline-block rounded-full border border-line bg-page px-3.5 py-1 text-sm font-semibold text-ink-secondary">
      {pill}
    </span>
  </p>
  <h3 class="mt-5 text-xl font-bold text-ink md:text-2xl">{title}</h3>
  <p class="mt-3 leading-relaxed text-ink-secondary">{body}</p>
  <p class="mt-auto pt-6">
    <span class="audience-cta inline-flex items-center gap-1.5 font-semibold text-ink-secondary">
      查看更多
      <span class="cta-arrow" aria-hidden="true">→</span>
    </span>
  </p>
</a>

<style>
  .audience-card {
    border-color: var(--neutral-200);
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      transform 220ms ease;
  }

  .audience-card:hover,
  .audience-card:focus-visible {
    background-color: var(--reach-blue-50);
    border-color: var(--color-brand);
    transform: translateY(-4px);
  }

  .audience-card:focus-visible {
    outline: 2px solid var(--reach-blue-300);
    outline-offset: 2px;
  }

  .audience-cta .cta-arrow {
    transition: transform 200ms ease;
  }

  .audience-card:hover .audience-cta,
  .audience-card:focus-visible .audience-cta {
    color: var(--color-brand);
  }

  .audience-card:hover .cta-arrow,
  .audience-card:focus-visible .cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .audience-card,
    .audience-cta .cta-arrow {
      transition: none;
    }

    .audience-card:hover,
    .audience-card:focus-visible {
      transform: none;
    }

    .audience-card:hover .cta-arrow,
    .audience-card:focus-visible .cta-arrow {
      transform: none;
    }
  }
</style>
