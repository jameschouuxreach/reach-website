---
/**
 * 關於頁「我們的使命」的一列：標題（品牌詞＋大標合併一行）＋內文＋案例連結文字（左）、原版九宮格動畫 GIF（右）；
 * 手機單欄先文後圖。版型比照政府頁 IllustratedPoint。GIF 由 MissionScrollStory 原版幾何與時序逐幀輸出
 * （每列一段：外圍圓→連線→填滿），reduced-motion 改用同名 PNG 終態。圖示輔助相鄰正文，alt 留空。
 */
import type { MissionItem } from '../../data/mission';

interface Props {
  item: MissionItem;
  /** 只有第一列 eager，其餘 lazy */
  eager?: boolean;
}

const { item, eager = false } = Astro.props;
const src = `/images/about/mission-${item.index}`;
// 案例連結文字一律在第一個逗號後換行，排成兩行（業主指示）
const commaAt = item.caseLink.text.indexOf('，');
const linkHead = commaAt === -1 ? item.caseLink.text : item.caseLink.text.slice(0, commaAt + 1);
const linkTail = commaAt === -1 ? '' : item.caseLink.text.slice(commaAt + 1);
---

<article class="mp">
  <div class="mp-text">
    <h3 class="mp-title">
      <span class="mp-word">{item.word}</span><span class="mp-sep" aria-hidden="true">｜</span>{item.title}
    </h3>
    <p class="mp-body">{item.body}</p>
    <a href={item.caseLink.href} class="mp-link">
      {linkHead}{linkTail && <br />}{linkTail}<span class="mp-arrow" aria-hidden="true">&nbsp;→</span>
    </a>
  </div>
  <div class="mp-media">
    <picture>
      <source srcset={`${src}.png`} media="(prefers-reduced-motion: reduce)" />
      <img
        src={`${src}.gif`}
        alt=""
        width="720"
        height="720"
        decoding="async"
        loading={eager ? 'eager' : 'lazy'}
      />
    </picture>
  </div>
</article>

<style>
  .mp {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .mp {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .mp {
      gap: 4rem;
    }
  }

  .mp-text {
    max-width: 34rem;
  }

  .mp-title {
    font-size: clamp(1.375rem, 1.15rem + 0.9vw, 1.75rem); /* 手機 22px → 桌機 28px，同政府頁 */
    font-weight: 700;
    line-height: 1.45;
  }

  .mp-body {
    margin-top: 0.875rem;
    color: var(--color-ink-secondary);
    line-height: 1.8;
  }

  .mp-word {
    color: var(--color-brand);
  }

  .mp-sep {
    color: var(--color-ink-soft);
    font-weight: 400;
  }

  /* 案例連結文字：品牌連結色、粗體，hover 底線；箭頭不換行跟在句尾 */
  .mp-link {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-link);
    font-weight: 700;
    line-height: 1.7;
    text-decoration: none;
  }

  .mp-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mp-arrow {
    display: inline-block;
    white-space: nowrap;
    transition: transform 0.2s ease;
  }

  .mp-link:hover .mp-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .mp-arrow {
      transition: none;
    }
  }

  .mp-media {
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
  }

  .mp-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }
</style>
