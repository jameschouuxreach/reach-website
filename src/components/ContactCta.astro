---
/**
 * 最終聯絡 CTA（首頁與內頁共用）。
 * 底色採品牌色 Reach Blue 500。
 * 左欄：標題（兩行，第二行縮小）＋按鈕；右欄：Reach us，樣式比照 Hero 右欄（白色分隔線＋白字）。
 */
---

<section class="cta-band">
  <div class="container-site py-20 md:py-28" data-reveal>
    <div class="cta-grid">
      {/* 左欄：標題兩行（第二行縮小），內容水平置中 */}
      <div class="cta-left">
        <h2 class="heading-section text-white">
          與我們聊聊你的需求
          <span class="cta-sub">一起找到改變的起點</span>
        </h2>
      </div>

      {/* 右欄：比照 Hero 右欄——左側白色分隔線；Reach us 單行＋按鈕，水平置中 */}
      <div class="cta-right">
        <p class="cta-en">Reach us</p>
        <div class="mt-8">
          <a href="/contact/" class="btn-on-blue">
            聯絡我們
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background-color: var(--reach-blue-500); /* 與「我們的使命」區塊同底色 */
  }

  /* ---- 兩欄佈局：比照 Hero（手機直排、md+ 左右各半、垂直互相置中） ---- */
  .cta-grid {
    /* 與 .heading-hero / index.astro .hero-grid 相同的字級公式，右欄字級按比例推導 */
    --hero-fs: clamp(2.5rem, 5.25vw - 3px, 4.125rem);
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .cta-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  /* 左欄：內容水平置中 */
  .cta-left {
    text-align: center;
  }

  /* 第二行：同標題級距下縮小、降字重 */
  .cta-sub {
    display: block;
    margin-top: 0.35em;
    font-size: 0.7em;
    font-weight: 500;
  }

  /* ---- 右欄：分隔線貼齊左緣，線與文字皆白（結構同 Hero .hc-right / .hc-en）；內容水平置中 ---- */
  .cta-right {
    border-inline-start: 2px solid var(--neutral-0);
    padding-inline-start: clamp(1.25rem, 3vw, 3rem);
    text-align: center;
  }

  @media (min-width: 768px) {
    /* 撐滿列高（列高由左欄決定），內容垂直置中，分隔線隨之等高 */
    .cta-right {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
  }

  .cta-en {
    font-size: 1.9375rem; /* 手機 31px，與 Hero 右欄一致 */
    line-height: 1.15;
    font-weight: 600;
    color: var(--neutral-0);
    margin: 0;
  }

  @media (min-width: 768px) {
    .cta-en {
      font-size: calc(var(--hero-fs) * 0.68);
    }
  }

  @media (min-width: 1024px) {
    .cta-en {
      font-size: calc(var(--hero-fs) * 0.75);
    }
  }

  .btn-on-blue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.75rem 2rem;
    border-radius: 9999px; /* 膠囊圓角 */
    background-color: var(--neutral-0);
    color: var(--color-brand);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .btn-on-blue:hover {
    background-color: var(--reach-blue-50);
  }

  .btn-on-blue:active {
    transform: translateY(1px);
  }

  .btn-on-blue:focus-visible {
    outline: 2px solid var(--reach-blue-300);
    outline-offset: 3px;
  }

  .btn-on-blue .cta-arrow {
    transition: transform 200ms ease;
  }

  .btn-on-blue:hover .cta-arrow,
  .btn-on-blue:focus-visible .cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-on-blue,
    .btn-on-blue .cta-arrow {
      transition: none;
    }
    .btn-on-blue:hover .cta-arrow,
    .btn-on-blue:focus-visible .cta-arrow {
      transform: none;
    }
  }
</style>
