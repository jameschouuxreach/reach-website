---
/**
 * 致遠觀點列表（依開發執行規格 §6）：PageHero → 一張真實文章卡 → 既有 ContactCta。
 * 移除原本的預留分類 pills 與三張「文章整理中」假卡；封面沿用圖 1（超市插畫）簡化版，
 * 標題／摘要取自 src/data/insights.ts，與文章頁、sitemap 共用同一份 metadata。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCta from '../components/ContactCta.astro';
import SupermarketFigure from '../components/insights/SupermarketFigure.astro';
import { FIRST_INSIGHT_ARTICLE } from '../data/insights';
import '../styles/insight-article.css';
---

<BaseLayout
  title="致遠觀點"
  description="致遠體驗設計對使用者研究、服務設計與數位轉型的觀察與思考。"
>
  <PageHero
    title="致遠觀點"
    intro="從真實的使用困擾出發，分享研究與設計如何幫助團隊找到改善方向。"
  />

  <section class="container-site py-16 md:py-24" data-reveal>
    <a href={FIRST_INSIGHT_ARTICLE.path} class="insight-card group block max-w-[680px] no-underline">
      <div class="insight-card-cover overflow-hidden rounded-xl border border-line" aria-hidden="true">
        <div class="insight-card-cover-art">
          <SupermarketFigure />
        </div>
      </div>
      <p class="mt-6 text-sm font-bold tracking-wide text-brand">{FIRST_INSIGHT_ARTICLE.category}</p>
      <h2 class="insight-card-title mt-2 text-xl font-bold text-ink md:text-2xl">{FIRST_INSIGHT_ARTICLE.title}</h2>
      <p class="mt-3 leading-relaxed text-ink-secondary">{FIRST_INSIGHT_ARTICLE.description}</p>
      <p class="insight-card-cta mt-5 inline-flex items-center gap-1.5 font-semibold text-brand">
        閱讀文章
        <span class="cta-arrow" aria-hidden="true">→</span>
      </p>
    </a>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  /* 封面：簡化版圖 1，縮小文字、關閉互動細節，只保留故事輪廓當裝飾封面 */
  .insight-card-cover {
    background-color: var(--color-surface-accent);
  }

  .insight-card-cover-art {
    padding: 20px 16px 4px;
    transform: scale(0.92);
    transform-origin: top center;
    pointer-events: none;
  }

  .insight-card-cover-art :global(.sm-figure) {
    gap: 12px;
  }

  .insight-card-cover-art :global(.sm-panel) {
    padding: 12px 10px;
  }

  .insight-card-cover-art :global(.insight-panel-label),
  .insight-card-cover-art :global(.sm-bubble) {
    font-size: 0.75rem;
  }

  .insight-card-cover-art :global(.sm-chip) {
    font-size: 0.75rem;
    padding: 4px 8px;
  }

  .insight-card-title,
  .insight-card-cta {
    transition: color 200ms ease;
  }

  .insight-card:hover .insight-card-title,
  .insight-card:focus-visible .insight-card-title,
  .insight-card:hover .insight-card-cta,
  .insight-card:focus-visible .insight-card-cta {
    color: var(--color-brand);
  }

  .insight-card:focus-visible {
    outline: 2px solid var(--reach-blue-300);
    outline-offset: 4px;
    border-radius: 12px;
  }

  .insight-card-cta .cta-arrow {
    transition: transform 200ms ease;
  }

  .insight-card:hover .cta-arrow,
  .insight-card:focus-visible .cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .insight-card-title,
    .insight-card-cta,
    .insight-card-cta .cta-arrow {
      transition: none;
    }
    .insight-card:hover .cta-arrow,
    .insight-card:focus-visible .cta-arrow {
      transform: none;
    }
  }
</style>
