---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import MissionScrollStory from '../components/MissionScrollStory.astro';
import TextLink from '../components/TextLink.astro';
import AudienceCard from '../components/AudienceCard.astro';
import CaseCard from '../components/CaseCard.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import ContactCta from '../components/ContactCta.astro';
import { CASES } from '../data/cases';
import { SITE_NAME, SITE_NAME_EN } from '../config';

const positioning = [
  {
    index: '01',
    title: '讓決策源自理解',
    body: '透過研究走進使用者的真實情境，理解問題如何發生，讓每一步都有脈絡可循。',
  },
  {
    index: '02',
    title: '讓全局清晰可見',
    body: '從使用者體驗到組織營運，我們梳理流程、角色及互動，找出能牽動全局的關鍵施力點。',
  },
  {
    index: '03',
    title: '讓改變真實發生',
    body: '理解多方需求與現實限制，在複雜組織中找到可行路徑，讓洞察落地、讓設計產生影響。',
  },
];
---

<BaseLayout
  title={`${SITE_NAME} ${SITE_NAME_EN}｜從複雜，致清晰`}
  description="致遠體驗設計透過研究、全局梳理與多方協作，陪政府與企業從複雜走向清晰，找出可落地的改善方向。"
  isHome
>
  {/* ---- 2. Hero：滿版海報式＋四幕輪播（v1.1）。左欄中文主標打字輪替，右欄 Reach 句同步切換 ---- */}
  <section class="bg-page">
    <div class="hero-band" data-hc>
      <div class="hero-grid" data-reveal>
        {/* 左欄：主標（單一 H1；朗讀內容固定，動畫層 aria-hidden） */}
        <h1 class="heading-hero relative" data-hc-stage>
          <span class="sr-only">從複雜，致清晰，陪你走得更深、更廣、更遠。致遠體驗設計。</span>

          {/* 靜態備援：無 JS 或 reduced-motion 時顯示 */}
          <span class="hc-static" aria-hidden="true">
            <span class="block">從複雜，<span class="text-brand">致</span>清晰</span>
            <span class="mt-3 block">陪你走得更深、更廣、更<span class="text-brand">遠</span></span>
          </span>

          {/* 輪播動畫層 */}
          <span class="hc-anim" aria-hidden="true">
            <span class="hc-line block" data-hc-line1
              >從複雜，<span class="text-brand" data-hc-zhi>致</span>清晰</span
            >
            {/* 深不預設 is-current：首次載入由腳本滑入（與換幕同一轉場） */}
            <span class="hc-line mt-3 block" data-hc-line2
              >陪你走得更<span class="hc-slot text-brand" data-hc-left
                ><span class="hc-slide-item">深</span><span class="hc-slide-item">廣</span
                ><span class="hc-slide-item">遠</span></span
              ></span
            >
            {/* 第四幕：致遠合併後「體驗設計」自下方滑入 */}
            <span class="hc-brand" data-hc-brand
              ><span class="text-brand hc-brand-char" data-hc-brand-zhi>致</span><span
                class="text-brand hc-brand-char"
                data-hc-brand-yuan>遠</span
              ><span class="hc-brand-rest"
                ><span class="hc-slide-item" data-hc-brand-rest>體驗設計</span></span
              ></span
            >
          </span>
        </h1>

        {/* 右欄：Reach 句＋對應中文句（無卡片外框） */}
        <div class="hc-right">
          <p class="sr-only">
            Reach deeper understanding，讓決策源自理解。Reach the bigger
            picture，讓全局清晰可見。Reach change that matters，讓改變真實發生。Reach
            Experience Design。
          </p>

          {/* 靜態備援 */}
          <div class="hc-static" aria-hidden="true">
            <p class="hc-en-static"><span class="text-brand">Reach</span> deeper understanding</p>
            <p class="hc-en-static"><span class="text-brand">Reach</span> the bigger picture</p>
            <p class="hc-en-static"><span class="text-brand">Reach</span> change that matters</p>
            <p class="hc-en-static"><span class="text-brand">Reach</span> better experiences</p>
          </div>

          {/* 輪播動畫層：Reach 與主標同步一開始就顯示、固定不動；詞組與中文句垂直滑動輪替
              （舊字上滑出、新字下方進），首幕兩行不預設 is-current，由腳本進場滑入 */}
          <div class="hc-anim hc-right-anim" aria-hidden="true">
            <p class="hc-en"><span class="text-brand">Reach</span></p>
            <div class="hc-en hc-slide" data-hc-phrase>
              <span class="hc-slide-item">deeper understanding</span>
              <span class="hc-slide-item">the bigger picture</span>
              <span class="hc-slide-item">change that matters</span>
              <span class="hc-slide-item">Experience</span>
            </div>
            <div class="hc-en hc-slide hc-line3" data-hc-zh>
              <span class="hc-slide-item hc-zh-item">讓決策源自理解</span>
              <span class="hc-slide-item hc-zh-item">讓全局清晰可見</span>
              <span class="hc-slide-item hc-zh-item">讓改變真實發生</span>
              <span class="hc-slide-item">Design</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---- 3. Why We Do／我們的使命（捲動敘事版，見 MissionScrollStory） ---- */}
  <MissionScrollStory items={positioning} />

  {/* ---- 4. What We Do／我們的服務 ---- */}
  <section class="border-t border-line bg-page">
    <div class="container-site py-16 md:py-24">
      <SectionLabel zh="我們的服務" en="WHAT WE DO" />
      <div class="mt-10 grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div data-reveal>
          <h3 class="heading-sub max-w-xl">從未知到已知，讓改變有清楚的方向</h3>
          <p class="mt-5 max-w-xl leading-loose text-ink-secondary">
            面對複雜問題，我們從真實情境出發，結合研究、全局梳理與多方協作，釐清真正影響成效的關鍵，形成可執行的改善方向。
          </p>
          <p class="mt-8">
            <TextLink href="/services/" label="服務項目" />
          </p>
        </div>

        {/* 未知到已知：六個重疊圓由左至右、透明度遞增至品牌原色（無文字符號） */}
        <div data-reveal>
          <svg
            viewBox="0 0 560 280"
            class="wd-visual h-auto w-full"
            role="img"
            aria-label="示意圖：六個圓形由左至右重疊排列，顏色由淺至品牌藍原色，象徵從未知逐步走向已知"
          >
            {/* 實色（原透明度混色的烘焙值）；繪製順序左→右，右圓疊在左圓之上 */}
            <circle class="wd-circle" cx="80" cy="140" r="80" fill="#DFE8FA"></circle>
            <circle class="wd-circle" cx="156" cy="140" r="80" fill="#CCDCFB"></circle>
            <circle class="wd-circle" cx="232" cy="140" r="80" fill="#B0C9FC"></circle>
            <circle class="wd-circle" cx="308" cy="140" r="80" fill="#86ADFC"></circle>
            <circle class="wd-circle" cx="384" cy="140" r="80" fill="#4D88FE"></circle>
            <circle class="wd-circle" cx="460" cy="140" r="80" fill="var(--reach-blue-500)"></circle>
          </svg>
        </div>
      </div>

    </div>
  </section>

  {/* ---- 5. 我們與誰合作（獨立區塊，與其他區塊同級） ---- */}
  <section class="border-t border-line bg-page">
    <div class="container-site py-16 md:py-24">
      <div data-reveal>
        <SectionLabel zh="我們與誰合作" en="WHO WE WORK WITH" />
        <div class="mt-10 grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
          <div>
            <h3 class="heading-sub max-w-xl">解法因情境而異，核心始終如一</h3>
            <p class="mt-5 max-w-xl leading-loose text-ink-secondary">
              面對不同的目標、限制與協作方式，我們找出合適的切入點，讓解法符合情境，也能真正落地。
            </p>
          </div>

          {/* 三圓圖示（無線條，三階品牌藍色塊，與「我們的服務」六圓同色階）。
              二段式進場動畫：初始三圓相同（上淺下中階）；
              第一段同時旋轉（左 270°、中 180°、右 180°＋中階色塊邊轉邊長大）；
              第二段同時（左：深色弓形以圓頂點為軸旋開露出；中：內圓再轉 180°、
              跨過水平線的部分即為深色；右：再轉 180°＋深色底塊自圓周外滑入）。
              一律幾何呈現（旋轉／滑入／裁切），無漸變；皆帶回彈（overshoot 後彈回）。
              終態與靜態版完全一致；無 JS／reduced-motion 直接顯示終態。 */}
          <svg
            viewBox="0 0 660 220"
            class="ww-visual h-auto w-full"
            role="img"
            aria-label="示意圖：三個圓形各以不同方式分層填色，色塊代表不同情境下的切入點"
          >
            <defs>
              <clipPath id="ww-clip-a"><circle cx="110" cy="110" r="90"></circle></clipPath>
              {/* 左圓右半平面：深色層與遮板都限制在右半 */}
              <clipPath id="ww-clip-a-r"><rect x="110" y="18" width="94" height="184"></rect></clipPath>
              <clipPath id="ww-clip-b"><circle cx="330" cy="110" r="90"></circle></clipPath>
              {/* 中圓水平線以下：深色半圓只在跨過水平線的部分顯示 */}
              <clipPath id="ww-clip-b-low"><rect x="238" y="110" width="184" height="94"></rect></clipPath>
              <clipPath id="ww-clip-c"><circle cx="550" cy="110" r="90"></circle></clipPath>
            </defs>

            {/* 圓一：整體轉 270° → 第二段：深色右半圓形以頂點 (110,20) 為軸旋入。
                初始轉 90°（整片在圓外，不可見），旋回 25° 時其直邊恰為 130° 弓形的弦
                （頂點圓周角＝圓心角一半），露出的深色恆為貼著圓弧的弓形；
                回彈超過 25° 時弓形真的變大再縮回。 */}
            <g clip-path="url(#ww-clip-a)">
              <g class="ww-a-spin">
                <circle cx="110" cy="110" r="90" class="ww-l"></circle>
                <rect x="18" y="110" width="184" height="94" class="ww-m"></rect>
              </g>
              <g clip-path="url(#ww-clip-a-r)">
                <path d="M 110 20 A 90 90 0 0 1 110 200 Z" class="ww-d ww-a-dark"></path>
              </g>
            </g>

            {/* 圓二：整體轉 180° → 內圓再轉 180°。深色＝獨立的同步旋轉半圓，
                以靜態「水平線以下」裁切：只有跨過水平線的部分顯示為深色（非漸變）。
                內圓中階半圓維持中階色，與深色層同步旋轉、始終重合。 */}
            <g clip-path="url(#ww-clip-b)">
              <g class="ww-b-spin">
                <circle cx="330" cy="110" r="90" class="ww-l"></circle>
                <rect x="238" y="110" width="184" height="94" class="ww-m"></rect>
                <g class="ww-b-inner">
                  <path d="M 278 111 A 52 52 0 0 1 382 111 Z" class="ww-l"></path>
                  <path d="M 278 110 A 52 52 0 0 0 382 110 Z" class="ww-m"></path>
                </g>
              </g>
              <g clip-path="url(#ww-clip-b-low)">
                <g class="ww-b-darkspin">
                  <path d="M 278 110 A 52 52 0 0 1 382 110 Z" class="ww-d"></path>
                </g>
              </g>
            </g>

            {/* 圓三：第一段轉 180°，中階半平面同時把邊界外推 30——原本的色塊
                邊旋轉邊長大（非另一塊飛入）；第二段再轉 180°（長大後的中階整片翻面），
                深色底塊自圓周下緣外向上滑入落定於 140–200。 */}
            <g clip-path="url(#ww-clip-c)">
              <g class="ww-c-spin1">
                <g class="ww-c-spin2">
                  <circle cx="550" cy="110" r="90" class="ww-l"></circle>
                  <rect x="458" y="110" width="184" height="126" class="ww-m ww-c-med"></rect>
                </g>
              </g>
              <rect x="458" y="140" width="184" height="160" class="ww-d ww-c-cap"></rect>
            </g>
          </svg>
        </div>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2" data-reveal>
        <AudienceCard
          pill="政府與公共服務"
          title="深耕數位公共服務，始終以民眾為本"
          body="我們熟悉政府標案、跨單位協作與既有系統限制，在民眾需要、政策目標與執行現實之間，找到真正可行的改善方向。"
          href="/public-sector/"
          ariaLabel="查看更多：政府與公共服務"
        />
        <AudienceCard
          pill="企業與服務團隊"
          title="找對問題，讓體驗改善轉為商業價值"
          body="從使用者、服務流程與組織全局中找出關鍵施力點，讓重大決策建立在理解之上。"
          href="/business/"
          ariaLabel="查看更多：企業與服務團隊"
        />
      </div>
    </div>
  </section>

  {/* ---- AI 主張（移至我們的經驗上方）---- */}
  <section class="border-t border-line bg-page">
    <div class="container-site py-20 text-center md:py-28" data-reveal>
      <h2 class="heading-section mx-auto max-w-4xl">
        AI 讓產出<span class="ai-em">更快速</span>，我們讓成果<span class="ai-em">更精準</span>
      </h2>
      <p class="mx-auto mt-6 max-w-2xl leading-loose text-ink-secondary">
        AI 能快速產出，但產出的價值仍取決於對問題的理解深度。<br
          class="hidden md:inline"
        />我們結合 AI 的效率、使用者研究與全局判斷，讓成果真正回應需求。
      </p>
      <div class="mt-9 flex justify-center">
        <a href="/services/" class="ai-cta">
          了解更多
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* ---- 6. 精選案例 ---- */}
  <section class="border-t border-line bg-page">
    <div class="container-site py-16 md:py-24">
      <div class="flex flex-wrap items-baseline justify-between gap-4" data-reveal>
        <SectionLabel zh="我們的經驗" en="OUR EXPERIENCE" />
        <TextLink href="/cases/" label="所有案例" />
      </div>
      <div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2" data-reveal>
        {CASES.map((item) => <CaseCard {...item} />)}
      </div>
    </div>
  </section>

  {/* ---- 7. 信任與合作（v1.1：Reach 品牌動態併入 Hero，此區保留合作 Logo）---- */}
  <section class="border-t border-line bg-page">
    <h2 class="sr-only">信任與合作</h2>
    <div class="container-site py-16 md:py-24" data-reveal>
      <PartnerLogos />
    </div>
  </section>

  {/* ---- 8. 最終聯絡 CTA ---- */}
  <ContactCta />

  <script>
    import '../scripts/hero-carousel';
  </script>
</BaseLayout>

<style>
  /* AI 主張 CTA：藍框白底藍字 */
  .ai-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.625rem 1.75rem;
    border-radius: 9999px;
    border: 1px solid var(--color-brand);
    background-color: var(--color-surface);
    color: var(--color-link);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .ai-cta:hover {
    background-color: var(--reach-blue-50);
  }

  .ai-cta:active {
    transform: translateY(1px);
  }

  .ai-cta:focus-visible {
    outline: 2px solid var(--reach-blue-300);
    outline-offset: 2px;
  }

  .ai-cta .cta-arrow {
    transition: transform 200ms ease;
  }

  .ai-cta:hover .cta-arrow,
  .ai-cta:focus-visible .cta-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-cta,
    .ai-cta .cta-arrow {
      transition: none;
    }
    .ai-cta:hover .cta-arrow {
      transform: none;
    }
  }

  /* AI 主張強調詞：藍色螢光筆畫記，進場時由左至右掃過（兩詞同時） */
  .ai-em {
    color: var(--color-text);
    background-image: linear-gradient(var(--reach-blue-200), var(--reach-blue-200));
    background-repeat: no-repeat;
    background-size: 100% 100%;
    background-position: 0 50%;
    padding-inline: 0.06em;
    margin-inline: -0.03em;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ai-em {
      background-size: 0% 100%;
      transition: background-size 550ms cubic-bezier(0.65, 0, 0.35, 1);
      transition-delay: 250ms; /* 兩詞同時開始 */
    }

    :global(html.js) [data-reveal].is-visible .ai-em {
      background-size: 100% 100%;
    }
  }

  /* ---- 滿版 Hero：內距約 80px（5.5vw 封頂），桌機高度撐到視窗高扣掉 header ---- */
  .hero-band {
    padding-inline: clamp(1.25rem, 5.5vw, 5rem);
    padding-block: 5rem 4rem;
    overflow-x: clip; /* 垂直合併期間品牌行的隱形佔位盒可能超出，夾住避免水平捲動 */
  }

  @media (min-width: 768px) {
    .hero-band {
      display: flex;
      flex-direction: column;
      justify-content: center;
      /* header 桌機高 72px；svh 避免行動瀏覽器網址列造成跳動 */
      min-height: calc(100svh - 4.5rem);
      padding-block: 3rem;
    }
  }

  /* ---- Hero 兩欄 ----
     --hero-fs 與 .heading-hero 的 clamp 公式一致，右欄字級按比例推導以維持左右等高 */
  .hero-grid {
    --hero-fs: clamp(2.5rem, 5.25vw - 3px, 4.125rem);
    /* 左欄前導內距：讓主標離左緣遠一點、靠近中間（手機為 0，md+ 於下方 media 設值） */
    --hero-lead: 0rem;
    /* 字槽滑動：時長與緩動（開頭漸快、結尾漸慢 easeInOutQuint）在此統一調整；
       SLIDE_MS in hero-carousel.ts 需與 --hc-dur 同步 */
    --hc-dur: 850ms;
    --hc-fly-dur: 850ms; /* 幕3→4 致遠合併飛行：與 --hc-dur 同步（與右欄切換同始同終） */
    --hc-fly-ease: cubic-bezier(0.65, 0, 0.35, 1); /* 飛行用 easeInOutCubic：中段較緩 */
    --hc-ease: cubic-bezier(0.83, 0, 0.17, 1);
    display: grid;
    gap: 2.75rem;
    align-items: center;
    transition: opacity 440ms ease;
  }

  @media (min-width: 768px) {
    .hero-grid {
      /* 前導內距隨寬度遞增（768 起約 17px → 1440 約 71px），推左標靠中間 */
      --hero-lead: clamp(0rem, 8vw - 2.75rem, 5rem);
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .hero-grid > h1 {
      padding-inline-start: var(--hero-lead);
    }

    /* 右欄撐滿列高（列高由左欄 H1 決定），三行以 space-between 對齊上下緣 */
    .hc-right {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  /* 分隔線：貼齊右欄區塊左緣，高度＝文字區塊高度 */
  .hc-right {
    border-inline-start: 2px solid var(--color-border);
    padding-inline-start: clamp(1.25rem, 3vw, 3rem);
  }

  [data-hc].is-resetting .hero-grid {
    opacity: 0;
  }

  /* ---- 輪播／靜態備援切換：預設靜態，JS＋允許動態時啟用輪播 ---- */
  .hc-static {
    display: block;
  }

  .hc-anim {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hc-anim {
      display: block;
    }

    :global(html.js) .hc-static {
      display: none;
    }
  }

