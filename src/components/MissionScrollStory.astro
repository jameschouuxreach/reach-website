---
/**
 * 我們的使命：釘住式捲動敘事（v3）。
 * - 桌機＋JS：260vh 跑道內一個 100vh sticky 畫面；區塊滑到定位後釘住，
 *   繼續捲動驅動三階段。左側字幕以 Hero 式垂直滑動輪替（第一點初始即顯示，無進場動畫）；
 *   每次輪替與右側該階段動畫同一進度門檻同時開始，階段窗結束後才輪到下一點。
 * - 右側 SVG 初始只有中心實心白圓；三階段：外圍圓 無→虛線→實線 → 八條連線 → 外圍圓填滿。
 * - 行動版／reduced-motion／無 JS：改為三段靜態排列（文字＋對應終態圖）。
 */
interface MissionItem {
  index: string;
  title: string;
  body: string;
}

interface Props {
  items: MissionItem[];
}

const { items } = Astro.props;
if (items.length !== 3) {
  throw new Error(`MissionScrollStory 需要恰好 3 個項目，收到 ${items.length} 個`);
}

// ---- SVG 固定幾何（建置時計算，不在 scroll frame 重算）----
const CX = 400;
const CY = 400;
const CENTER_R = 64;
const OUTER_R = 42;
const ORBIT_R = 245;
const SEGMENTS = 12; // 每個外圍圓 12 段 30° 弧段
const STROKE = 3.2;
const CAP_INSET = STROKE / 2; // 圓角端點內縮：讓 round cap 剛好停在圓周

const round = (n: number) => Math.round(n * 100) / 100;

const rings = Array.from({ length: 8 }, (_, i) => {
  const angle = ((-90 + i * 45) * Math.PI) / 180;
  const dx = Math.cos(angle);
  const dy = Math.sin(angle);
  return {
    cx: round(CX + dx * ORBIT_R),
    cy: round(CY + dy * ORBIT_R),
    lineX1: round(CX + dx * (CENTER_R + CAP_INSET)),
    lineY1: round(CY + dy * (CENTER_R + CAP_INSET)),
    lineX2: round(CX + dx * (ORBIT_R - OUTER_R - CAP_INSET)),
    lineY2: round(CY + dy * (ORBIT_R - OUTER_R - CAP_INSET)),
  };
});

/** 每段 30° 弧段：起點固定、順時針（SVG y 軸向下，角度遞增即順時針） */
function arcSegments(cx: number, cy: number): string[] {
  return Array.from({ length: SEGMENTS }, (_, s) => {
    const a0 = ((s * 30 - 90) * Math.PI) / 180;
    const a1 = (((s + 1) * 30 - 90) * Math.PI) / 180;
    const x0 = round(cx + OUTER_R * Math.cos(a0));
    const y0 = round(cy + OUTER_R * Math.sin(a0));
    const x1 = round(cx + OUTER_R * Math.cos(a1));
    const y1 = round(cy + OUTER_R * Math.sin(a1));
    return `M ${x0} ${y0} A ${OUTER_R} ${OUTER_R} 0 0 1 ${x1} ${y1}`;
  });
}

// 後備版三段靜態終態
const staticFigures = [
  { links: false, fill: false }, // 第一段：外圍實線圈
  { links: true, fill: false }, // 第二段：連線完成
  { links: true, fill: true }, // 第三段：全實心
];
---

<section data-mission-story class="ms-section">
  {/* ---- 桌機＋JS：釘住式敘事 ---- */}
  <div class="msp-desktop" data-msp>
    <div class="msp-pin">
      <div class="container-site msp-frame">
        <h2 class="ms-label">
          <span class="ms-label-zh">我們的使命</span>
          <span class="ms-label-en" aria-hidden="true">WHY WE DO</span>
        </h2>

        <div class="msp-grid">
          {/* 左：字幕輪替槽（Hero 式垂直滑動；第一點初始即顯示） */}
          <div class="msp-slot">
            {
              items.map((item, i) => (
                <article class:list={['msp-item', i === 0 && 'is-current']} data-msp-item>
                  <p class="ms-index" aria-hidden="true">
                    {item.index}
                  </p>
                  <h3 class="ms-title">{item.title}</h3>
                  <p class="ms-body">{item.body}</p>
                </article>
              ))
            }
          </div>

          {/* 右：SVG（初始只有中心實心圓） */}
          <div class="msp-figure">
            <svg viewBox="0 0 800 800" data-mission-svg class="ms-svg" aria-hidden="true" focusable="false">
              <circle cx={CX} cy={CY} r={CENTER_R} class="ms-center" />
              {
                rings.map((r) => (
                  <line
                    x1={r.lineX1}
                    y1={r.lineY1}
                    x2={r.lineX2}
                    y2={r.lineY2}
                    pathLength="1"
                    class="ms-link"
                  />
                ))
              }
              <g class="ms-arcs">
                {
                  rings.map((r) =>
                    arcSegments(r.cx, r.cy).map((d) => <path d={d} pathLength="1" class="ms-arc" />),
                  )
                }
              </g>
              <g class="ms-ringfulls">
                {rings.map((r) => <circle cx={r.cx} cy={r.cy} r={OUTER_R} class="ms-ringfull" />)}
              </g>
              {rings.map((r) => <circle cx={r.cx} cy={r.cy} r={OUTER_R} class="ms-fill ms-fill-outer" />)}
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* ---- 後備版（行動版／reduced-motion／無 JS）：三段靜態排列 ---- */}
  <div class="msp-fallback">
    <div class="container-site msp-fb-inner">
      <h2 class="ms-label">
        <span class="ms-label-zh">我們的使命</span>
        <span class="ms-label-en" aria-hidden="true">WHY WE DO</span>
      </h2>
      {
        items.map((item, i) => (
          <article class="ms-fb-panel">
            <p class="ms-index" aria-hidden="true">
              {item.index}
            </p>
            <h3 class="ms-title">{item.title}</h3>
            <p class="ms-body">{item.body}</p>
            <div class="ms-fig-wrap" aria-hidden="true">
              <svg viewBox="0 0 800 800" class="ms-fig" aria-hidden="true" focusable="false">
                <circle cx={CX} cy={CY} r={CENTER_R} class="msf-solid" />
                {staticFigures[i].links &&
                  rings.map((r) => (
                    <line x1={r.lineX1} y1={r.lineY1} x2={r.lineX2} y2={r.lineY2} class="msf-line" />
                  ))}
                {rings.map((r) => (
                  <circle
                    cx={r.cx}
                    cy={r.cy}
                    r={OUTER_R}
                    class={staticFigures[i].fill ? 'msf-solid' : 'msf-outline'}
                  />
                ))}
              </svg>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ms-section {
    background-color: var(--reach-blue-500);
  }

  /* ---- 變體切換：預設後備版；桌機＋JS＋允許動態時改釘住版 ---- */
  .msp-desktop {
    display: none;
    height: 100vh; /* v4 步進制：單屏區塊，鎖定後以手勢逐步推進 */
  }

  @media (min-width: 769px) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .msp-desktop {
      display: block;
    }

    :global(html.js) .msp-fallback {
      display: none;
    }
  }

  /* ---- 版面（100vh 單屏） ---- */
  .msp-pin {
    height: 100%;
    overflow: hidden;
  }

  .msp-frame {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding-block: 5rem 3rem;
  }

  .msp-grid {
    flex: 1;
    display: grid;
    grid-template-columns: 48fr 52fr;
    align-items: center;
    min-height: 0;
  }

  /* 左：字幕輪替槽（同格堆疊＋遮罩；只做垂直位移＋淡入淡出） */
  .msp-slot {
    display: grid;
    overflow: hidden;
  }

  .msp-item {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(110%);
    transition:
      transform 850ms cubic-bezier(0.83, 0, 0.17, 1),
      opacity 600ms ease;
  }

  .msp-item.is-above {
    transform: translateY(-110%);
  }

  .msp-item.is-current {
    opacity: 1;
    transform: none;
  }

  .msp-slot.no-anim .msp-item {
    transition: none;
  }

  .msp-figure {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    height: 100%;
  }

  .ms-svg {
    width: min(100%, 640px);
    height: auto;
    max-height: 74vh;
  }

  /* ---- 反白版區塊標籤 ---- */
  .ms-label {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .ms-label-zh {
    font-size: 1rem;
    font-weight: 700;
    color: var(--neutral-0);
  }

  .ms-label-en {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.9);
  }

  /* ---- 文字樣式（兩個變體共用） ---- */
  .ms-index {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgb(255 255 255 / 0.75);
  }

  .ms-title {
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 4vw, 4.5rem);
    line-height: 1.15;
    font-weight: 700;
    color: var(--neutral-0);
  }

  .ms-body {
    margin-top: 1.25rem;
    font-size: clamp(1.125rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.8;
    color: rgb(255 255 255 / 0.88);
    max-width: 30em;
  }

  /* ---- 主 SVG 元素狀態（CSS 變數預設＝最終完整狀態；JS 逐幀覆寫） ---- */
  .ms-svg {
    --ms-arc: 1;
    --ms-ringfull: 1;
    --ms-line: 1;
    --ms-fill-outer: 1;
  }

  .ms-center {
    fill: var(--neutral-0);
    stroke: none;
  }

  .ms-link {
    stroke: var(--neutral-0);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-dasharray: var(--ms-line) 1;
    /* 圓角端點在長度 0 時會是一顆圓點：長度趨近 0 時整條透明 */
    opacity: min(calc(var(--ms-line) * 25), 1);
  }

  .ms-arc {
    fill: none;
    stroke: var(--neutral-0);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-dasharray: var(--ms-arc) 1;
    stroke-dashoffset: 0;
  }

  /* 收尾：完整實線圓淡入時，分段弧線同步淡出；
     另以長度門檻處理 round cap 在 0 長度時的殘留圓點（96 顆小點→透明） */
  .ms-arcs {
    opacity: min(calc(1 - var(--ms-ringfull)), calc(var(--ms-arc) * 25), 1);
  }

  .ms-ringfull {
    fill: none;
    stroke: var(--neutral-0);
    stroke-width: 3.2;
    opacity: var(--ms-ringfull);
  }

  .ms-fill {
    fill: var(--neutral-0);
    stroke: none;
    transform-box: fill-box;
    transform-origin: center;
  }

  .ms-fill-outer {
    transform: scale(var(--ms-fill-outer));
  }

  /* ---- 後備版 ---- */
  .msp-fb-inner {
    padding-block: 4rem 3rem;
  }

  .ms-fb-panel {
    padding-block: 2.5rem;
  }

  .ms-fb-panel + .ms-fb-panel {
    border-top: 1px solid rgb(255 255 255 / 0.22);
  }

  .ms-fig-wrap {
    margin-top: 2rem;
  }

  .ms-fig {
    display: block;
    width: min(300px, 72%);
    height: auto;
    margin-inline: auto;
  }

  .msf-outline {
    fill: none;
    stroke: var(--neutral-0);
    stroke-width: 3.2;
  }

  .msf-solid {
    fill: var(--neutral-0);
    stroke: none;
  }

  .msf-line {
    stroke: var(--neutral-0);
    stroke-width: 3.2;
    stroke-linecap: round;
  }
</style>

<script>
  import '../scripts/mission-scroll';
</script>
