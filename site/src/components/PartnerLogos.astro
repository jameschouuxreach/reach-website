---
/**
 * 合作對象 Logo 輪播（v2）：企業與政府 Logo 交錯混排成單列無限輪播，
 * 左右以遮罩淡出（參考 uxi-design.com）。僅使用已提供的真實 Logo（合作客戶logo.pdf）。
 * Logo 以 multiply 混色融入頁面灰底（白底 PNG 視同透明）、灰階呈現，hover 恢復原色。
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PARTNER_COMPANIES, PARTNER_GOVERNMENT, type Partner } from '../data/partners';

const logoModules = import.meta.glob<{ default: ImageMetadata }>('../assets/partners/*.png', {
  eager: true,
});

function logoFor(slug: string): ImageMetadata {
  const entry = logoModules[`../assets/partners/${slug}.png`];
  if (!entry) throw new Error(`缺少 Logo 素材：${slug}`);
  return entry.default;
}

// 企業與政府一比一交錯，避免同類相鄰成排
const mixed: Partner[] = [];
const maxLen = Math.max(PARTNER_COMPANIES.length, PARTNER_GOVERNMENT.length);
for (let i = 0; i < maxLen; i++) {
  const company = PARTNER_COMPANIES[i];
  const gov = PARTNER_GOVERNMENT[i];
  if (company) mixed.push(company);
  if (gov) mixed.push(gov);
}
---

<div class="logo-marquee" role="img" aria-label={`合作客戶：${mixed.map((p) => p.name).join('、')}`}>
  <div class="logo-track">
    {
      [false, true].map((isCopy) => (
        <ul class="logo-set" aria-hidden={isCopy ? 'true' : undefined}>
          {mixed.map((partner) => (
            <li class="partner-logo flex items-center">
              <Picture
                src={logoFor(partner.slug)}
                formats={['webp']}
                fallbackFormat="png"
                alt={isCopy ? '' : partner.name}
                class="h-9 w-auto max-w-none object-contain md:h-10"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  /* 輪播容器：左右遮罩淡出。
     mask 會建立獨立堆疊上下文、隔離 mix-blend-mode 的 backdrop，
     故在群組內鋪一層頁面底色，讓 multiply 有灰底可混（白底 PNG 視同透明） */
  .logo-marquee {
    overflow: hidden;
    background-color: var(--color-page);
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }

  /* 軌道＝兩份等寬清單，位移 -50% 恰為一份，無縫循環。
     transform 動畫使 track 自成堆疊上下文（blend 的隔離層），
     頁面底色必須鋪在這層之內，multiply 才有灰底可混 */
  .logo-track {
    display: flex;
    width: max-content;
    background-color: var(--color-page);
    animation: logo-scroll 42s linear infinite;
  }

  .logo-marquee:hover .logo-track {
    animation-play-state: paused;
  }

  .logo-set {
    display: flex;
    align-items: center;
    flex: none;
    gap: clamp(2.75rem, 5vw, 4.5rem);
    padding-inline-end: clamp(2.75rem, 5vw, 4.5rem);
  }

  @keyframes logo-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .partner-logo :global(img) {
    /* multiply：白底 PNG 融入頁面灰底，等同 Logo 底色＝Hero 底色 */
    mix-blend-mode: multiply;
    filter: grayscale(1);
    opacity: 0.72;
    transition: filter 200ms ease, opacity 200ms ease;
  }

  .partner-logo:hover :global(img) {
    filter: none;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-track {
      animation: none;
    }

    .partner-logo :global(img) {
      transition: none;
    }
  }
</style>
