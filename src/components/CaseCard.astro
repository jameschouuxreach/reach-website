---
/**
 * 案例卡（v1.7，參照 AJA 版式）：獨立圖片 → 客戶類別小標 → 大標題 → 專案類型 pills。
 * 圖片為灰階佔位框（正式素材未提供）；專案類型僅使用已提供素材中的描述，未提供者顯示「案例整理中」。
 */
interface Props {
  name: string;
  /** 客戶類別（v1.7b 版式上不顯示，保留資料欄位） */
  tag?: string;
  types?: string[];
  mediaNote?: string;
}

const {
  name,
  types = ['案例整理中'],
  mediaNote = '需要素材：專案代表圖或研究現場照片',
} = Astro.props;
---

<article>
  <div class="media-placeholder aspect-[16/10] rounded-xl">
    {mediaNote}
  </div>
  <h3 class="mt-6 text-xl font-bold md:text-2xl">{name}</h3>
  <p class="mt-4 flex flex-wrap gap-2">
    {
      types.map((type) => (
        <span class="rounded-full border border-line bg-surface px-3.5 py-1 text-sm text-ink-secondary">
          {type}
        </span>
      ))
    }
  </p>
</article>
