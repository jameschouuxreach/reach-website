   *   下一幀把焦點移到目標 H2（tabindex=-1、preventScroll）。
   * - 窄螢幕目錄：Escape 收合並把焦點還給 summary；收合文字更新為「本頁目錄：目前段落」。
   * - 平滑捲動由全站 CSS scroll-behavior 控制，reduced-motion 時已改為直接定位。
   */
  const root = document.querySelector<HTMLElement>('[data-nd-read]');

  if (root) {
    const parts = Array.from(root.querySelectorAll<HTMLElement>('[data-nd-part]'));
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nd-toc] a[href^="#"]'));
    const details = root.querySelector<HTMLDetailsElement>('[data-nd-toc-mobile]');
    const summary = details?.querySelector<HTMLElement>('summary') ?? null;
    const currentLabel = details?.querySelector<HTMLElement>('[data-nd-toc-current]') ?? null;
    const header = document.querySelector<HTMLElement>('body > header');
    const names = new Map(parts.map((part) => [part.id, part.dataset.ndName ?? '']));

    let activeId = '';

    function setActive(id: string): void {
      if (id === activeId) return;
      activeId = id;
      for (const link of links) {
        if (link.getAttribute('href') === `#${id}`) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      }
      if (currentLabel) {
        currentLabel.textContent = `：${names.get(id) ?? ''}`;
        currentLabel.hidden = false;
      }
    }

    /**
     * 判定線：扣除 Header（＋窄螢幕目錄列）遮擋後的閱讀區頂緣。
     * 段落的 scroll-margin-top 正是「Header＋目錄列＋餘裕」，跳轉後段落頂緣剛好落在此線，
     * 因此直接讀它（含無 JS／展開狀態的 :has 變化）再加幾 px 容差，確保跳轉後的目標段落被標示。
     */
    function judgeLine(): number {
      const headerBottom = header ? Math.max(0, header.getBoundingClientRect().bottom) : 0;
      const barVisible = details && summary && getComputedStyle(details).display !== 'none';
      const barHeight = barVisible ? summary.getBoundingClientRect().height : 0;
      const margin = parseFloat(getComputedStyle(parts[0]).scrollMarginTop) || 0;
      return Math.max(headerBottom + barHeight, margin) + 4;
    }

    function update(): void {
      if (parts.length === 0) return;
      const last = parts[parts.length - 1];
      const doc = document.documentElement;
      const atPageBottom = window.innerHeight + window.scrollY >= doc.scrollHeight - 2;
      const readEndVisible = root!.getBoundingClientRect().bottom <= window.innerHeight;
      if (atPageBottom || readEndVisible) {
        setActive(last.id);
        return;
      }
      const line = judgeLine();
      let current = parts[0];
      for (const part of parts) {
        if (part.getBoundingClientRect().top <= line) current = part;
      }
      setActive(current.id);
    }

    let ticking = false;
    function request(): void {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    }

    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    window.addEventListener('hashchange', request);
    window.addEventListener('load', request);
    update();

    // 卡片與目錄的跳轉：先收合窄螢幕目錄，讓原生 hash 跳轉執行後再把焦點移到目標標題
    document.querySelectorAll<HTMLAnchorElement>('[data-nd-jump]').forEach((link) => {
      link.addEventListener('click', () => {
        const id = (link.getAttribute('href') ?? '').slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        if (details?.open && details.contains(link)) details.open = false;
        const heading = target.querySelector<HTMLElement>('[data-nd-heading]') ?? target;
        requestAnimationFrame(() => {
          heading.focus({ preventScroll: true });
          request();
        });
      });
    });

    details?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.open) {
        event.preventDefault();
        details.open = false;
        summary?.focus();
      }
    });
  }
</script>
