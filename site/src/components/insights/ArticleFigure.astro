---
/**
 * 觀點文章圖稿統一元件（2026-09-22 改版：全部改用真實配圖，取代先前的自製 HTML/SVG 插畫）。
 * - 單張 <img>＋<figcaption>；alt 為圖片內容的文字描述，figcaption 為對外可見的編輯圖說，
 *   兩者分工不同不重複朗讀。
 * - 寬度與內文同寬（不再另外放大到比正文更寬的「圖稿／比較區」框），由 .insight-article 統一控制。
 * - 圖檔一律放 public/images/insights/，已於本機轉檔為 WebP 並縮到 1520–1600px 寬（2x 視覺寬度已足夠）。
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption: string;
}

const { src, alt, width, height, caption } = Astro.props;
---

<figure class="insight-figure">
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="insight-figure-img" />
  <figcaption class="insight-figure-caption">{caption}</figcaption>
</figure>
