---
/**
 * 專案類型頁（第二層，六頁由 getStaticPaths 產出）：
 * Header → ServiceContextNav（返回常見專案類型＋六類切換）→ 專案 Hero
 * → 專案完整內容（適合以下情況｜常見情境舉例 → 專案目標 → 我們會如何協助 → 此專案通常包含哪些執行項目？→ 預期成效；2026-09-01 業主指示調整）
 * → 相關案例 → 常見問題 → 既有 ContactCta → Footer。
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactCta from '../../../components/ContactCta.astro';
import CaseCard from '../../../components/CaseCard.astro';
import ServiceContextNav from '../../../components/services/ServiceContextNav.astro';
import FaqList from '../../../components/services/FaqList.astro';
import RelatedCasePlaceholder from '../../../components/services/RelatedCasePlaceholder.astro';
import ProjectGlyph from '../../../components/services/ProjectGlyph.astro';
import ServiceItemLinkCard from '../../../components/services/ServiceItemLinkCard.astro';
import {
  PROJECT_TYPES,
  PROJECT_TYPES_HREF,
  SERVICE_FAQ,
  getProjectTypePath,
  getPublishedCase,
  resolveServiceItems,
  type ProjectType,
} from '../../../data/services';

export const getStaticPaths = (() =>
  PROJECT_TYPES.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;

interface Props {
  project: ProjectType;
}

const { project } = Astro.props;

const navItems = PROJECT_TYPES.map((item) => ({
  label: item.title,
  href: getProjectTypePath(item.slug),
  active: item.slug === project.slug,
}));

// 執行項目：由 slug 反查類別、說明與 anchor，不硬編碼名稱
const services = resolveServiceItems(project.serviceItemSlugs);
// 執行項目卡桌機欄數：5 個以上 3 欄，4 個以下 2 欄（避免 3＋1 孤卡）
const serviceColumns = services.length >= 5 ? 'lg:grid-cols-3' : 'lg:grid-cols-2';

// 相關案例：published 且能在 CASES 找到者用 CaseCard；其餘一律顯示整理中（不輸出連結）
const relatedCases = project.relatedCases.map((reference) => {
  const published = getPublishedCase(reference);
  return published ? { kind: 'published' as const, data: published } : { kind: 'preparing' as const, name: reference.name };
});

// 專案頁 description：副標＋適合以下情況（§16.1；fit 改列點後以「；」串接）
const description = `${project.subtitle}。適合以下情況：${project.fit.join('；')}。`;
---

<BaseLayout title={`${project.title}｜常見專案類型`} description={description}>
  <ServiceContextNav
    ariaLabel="常見專案類型切換"
    backLabel="常見專案類型"
    backHref={PROJECT_TYPES_HREF}
    items={navItems}
  />

  {/* ---- 專案 Hero（右下以專案類型標誌當背景裝飾，2026-08-31 業主指示）---- */}
  <section class="relative isolate overflow-hidden border-b border-line bg-page">
    {/* 手機版底部多留 120px：標誌固定住在文字下方的留白帶，不壓到副標 */}
    <div class="container-site relative pt-16 pb-30 md:py-24">
      <ProjectGlyph slug={project.slug} class="svc-hero-glyph" />
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand">{project.eyebrow}</p>
      <h1 class="heading-section mt-4 max-w-3xl">{project.title}</h1>
      <p class="mt-4 max-w-3xl text-xl font-semibold leading-relaxed text-ink md:text-2xl">{project.subtitle}</p>
    </div>
  </section>

  {/* ---- 專案完整內容 ---- */}
  <section class="bg-surface">
    <div class="container-site py-16 md:py-24">
      {/* 適合以下情況｜常見情境舉例：桌機兩欄、手機單欄。舉例為小型藍色標題＋Blue 50 底框（不用引號造型或假客戶照片） */}
      <div class="grid gap-10 md:grid-cols-2 md:gap-12" data-reveal>
        <div>
          <h2 class="heading-sub">適合以下情況</h2>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-[17px] leading-relaxed text-ink-secondary marker:text-brand md:text-lg">
            {project.fit.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div class="rounded-2xl border border-accent-100 bg-accent p-6 md:p-7">
          <h2 class="text-sm font-bold tracking-wide text-brand">常見情境舉例</h2>
          <p class="mt-3 text-[17px] leading-relaxed text-ink md:text-lg">{project.example}</p>
        </div>
      </div>

      {/* 專案目標：三張有標題的非互動卡片（2026-09-01 業主指示新增，置於「我們會如何協助」之上） */}
      <div class="mt-12 md:mt-16" data-reveal>
        <h2 class="heading-sub">專案目標</h2>
        <ul class="mt-6 grid gap-5 md:mt-8 md:grid-cols-2 lg:grid-cols-3">
          {
            project.goals.map((goal, index) => (
              <li class="card flex flex-col p-6 md:p-7">
                <p class="text-sm font-bold tabular-nums text-brand" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-3 text-lg font-bold text-ink md:text-xl">{goal.title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-ink-secondary md:text-base">{goal.body}</p>
              </li>
            ))
          }
        </ul>
      </div>

      {/* 我們會如何協助 */}
      <div class="mt-12 md:mt-16" data-reveal>
        <h2 class="heading-sub">我們會如何協助</h2>
        <p class="mt-4 max-w-3xl text-[17px] leading-relaxed text-ink-secondary md:text-lg">{project.approach}</p>
      </div>

      {/* 執行項目：卡片（類別標籤＋項目名稱＋與服務類別頁相同的說明），整卡連至服務類別頁對應 anchor */}
      <div class="mt-12 md:mt-16" data-reveal>
        <h2 class="heading-sub">此專案通常包含哪些執行項目？</h2>
        <p class="mt-4 max-w-3xl text-[17px] leading-relaxed text-ink-secondary md:text-lg">
          以下為常見執行項目，並非每個專案都需全部包含。我們會在釐清需求後，依據專案目標、預算與時程，規劃合適的執行組合。
        </p>
        <ul class:list={['mt-6 grid gap-5 md:mt-8 md:grid-cols-2', serviceColumns]}>
          {
            services.map((service) => (
              <li class="flex">
                <ServiceItemLinkCard {...service} />
              </li>
            ))
          }
        </ul>
      </div>

      {/* 預期成效：內文樣式，不寫成保證成效、KPI 或 ROI */}
      <div class="mt-12 md:mt-16" data-reveal>
        <h2 class="heading-sub">預期成效</h2>
        <p class="mt-4 max-w-3xl text-[17px] leading-relaxed text-ink-secondary md:text-lg">{project.value}</p>
      </div>
    </div>
  </section>

  {/* ---- 相關案例（relatedCases 為空時整個 section 不渲染）---- */}
  {
    relatedCases.length > 0 && (
      <section class="border-t border-line bg-page">
        <div class="container-site py-16 md:py-24">
          <h2 class="heading-sub" data-reveal>相關案例</h2>
          <div class="mt-8 grid gap-x-8 gap-y-12 md:mt-10 md:grid-cols-2" data-reveal>
            {relatedCases.map((entry) =>
              entry.kind === 'published' ? <CaseCard {...entry.data} /> : <RelatedCasePlaceholder name={entry.name} />,
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* ---- 常見問題 ---- */}
  <section class="border-t border-line bg-surface">
    <div class="container-site py-16 md:py-24">
      <div class="max-w-3xl" data-reveal>
        <h2 class="heading-sub">常見問題</h2>
        <div class="mt-8">
          <FaqList items={SERVICE_FAQ} />
        </div>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  /* Hero 背景標誌：靠右下、被區塊底邊裁切；置於文字之下（section isolate＋z-index:-1） */
  .svc-hero-glyph {
    position: absolute;
    z-index: -1;
    right: -4%;
    bottom: -38%;
    width: clamp(240px, 30vw, 420px);
    height: auto;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    /* 以 px 定位：可見部分固定 150×110px，落在 pb-30（120px）的留白帶內 */
    .svc-hero-glyph {
      right: -70px;
      bottom: -110px;
      width: 220px;
    }
  }

</style>
